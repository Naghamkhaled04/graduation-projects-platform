---
import { CATEGORIES, productsOf, ar, imgFallback } from '../data/storecats';

/** شريط أقسام أكورديون بصور — نفس نمط «تصفّح حسب القسم» بمتجرنا */
const TOP = 5;
const strip = [...CATEGORIES].sort((a, b) => b.n - a.n).slice(0, TOP).map((c) => {
  const withImg = productsOf(c.cat).find((p) => p.img);
  return { ...c, img: withImg?.img ?? '' };
});
---

<section class="nv-sec">
  <div class="strip-head">
    <h2>تصفّح حسب القسم</h2>
    <a class="nv-btn nv-btn--ghost" href="/store/all">كل الأقسام</a>
  </div>

  <div class="nv-strip">
    {strip.map((c, i) => (
      <a class:list={['nv-strip__panel', { 'is-open': i === 0 }]} href={`/store/${c.slug}`} data-i={i}>
        <img class="nv-strip__img" src={c.img || '/img/part.svg'} alt="" onerror={imgFallback} loading="lazy" decoding="async" />
        <span class="nv-strip__body">
          <span class="nv-strip__label">{c.cat}</span>
          <span class="nv-strip__count">{ar(c.n)} سلعة</span>
        </span>
        <span class="nv-strip__spine">{c.cat}</span>
      </a>
    ))}
  </div>
</section>

<script>
  const strip = document.querySelector('.nv-strip');
  if (strip) {
    const panels = [...strip.querySelectorAll<HTMLElement>('.nv-strip__panel')];
    const open = (el: HTMLElement) => panels.forEach((p) => p.classList.toggle('is-open', p === el));
    panels.forEach((p) => {
      p.addEventListener('mouseenter', () => open(p));
      p.addEventListener('focus', () => open(p));
    });
  }
</script>

<style is:global>
  .strip-head { display: flex; justify-content: space-between; align-items: center; gap: 14px; margin-bottom: 16px; }
  .strip-head h2 { margin: 0; }

  .nv-strip { display: flex; gap: 10px; height: clamp(240px, 34vw, 360px); overflow: hidden; }
  .nv-strip__panel {
    position: relative; flex: 1 1 0; min-width: 62px; border-radius: 18px; overflow: hidden;
    text-decoration: none; background: #efe6d8; border: 0.8px solid #e6dccd;
    transition: flex-grow .45s cubic-bezier(.22,1,.36,1), border-color .3s;
  }
  .nv-strip__panel.is-open { flex-grow: 4.2; border-color: #fa7b19; }
  .nv-strip__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; padding: 14%;
    background: #fffdf9; transition: transform .6s, opacity .4s; }
  .nv-strip__panel.is-open .nv-strip__img { transform: scale(1.04); }
  .nv-strip__panel:not(.is-open) .nv-strip__img { opacity: .45; }

  .nv-strip__body {
    position: absolute; inset-inline: 12px; bottom: 12px; display: grid; gap: 2px;
    background: rgba(26,22,19,.82); color: #fffdf9; backdrop-filter: blur(6px);
    border-radius: 14px; padding: 12px 16px; opacity: 0; transform: translateY(8px);
    transition: opacity .3s .1s, transform .35s .1s;
  }
  .nv-strip__panel.is-open .nv-strip__body { opacity: 1; transform: none; }
  .nv-strip__label { font-size: 15px; font-weight: 600; }
  .nv-strip__count { font-size: 12.5px; color: #fa7b19; }

  .nv-strip__spine {
    position: absolute; inset-inline-start: 50%; top: 50%; transform: translate(50%, -50%);
    writing-mode: vertical-rl; font-size: 14.5px; font-weight: 600; color: #1a1613;
    white-space: nowrap; transition: opacity .3s;
  }
  .nv-strip__panel.is-open .nv-strip__spine { opacity: 0; }

  @media (max-width: 760px) {
    .nv-strip { height: auto; flex-direction: column; gap: 8px; }
    .nv-strip__panel { flex: none; height: 92px; display: flex; align-items: center; }
    .nv-strip__panel.is-open { height: 200px; }
    .nv-strip__img { position: relative; width: 92px; height: 92px; padding: 10px; flex: none; opacity: 1 !important; background: transparent; }
    .nv-strip__panel.is-open .nv-strip__img { position: absolute; width: 100%; height: 100%; padding: 12%; background: #fffdf9; }
    .nv-strip__spine { writing-mode: horizontal-tb; position: static; transform: none; padding-inline-start: 6px; }
    .nv-strip__panel.is-open .nv-strip__spine { display: none; }
  }
</style>
