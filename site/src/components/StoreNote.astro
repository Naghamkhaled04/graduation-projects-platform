---
import catalog from '../data/abela.json';
import { svg } from '../data/icons';

const count = (catalog as unknown[]).length;
const ar = (n: number) => n.toLocaleString('ar-EG');
const cats = [...new Set((catalog as { cat: string }[]).map((c) => c.cat))].length;
---

<section class="sn" id="store-note">
  <div class="container">
    <div class="box">
      <div class="msg">
        <span class="k">رسالة منّا</span>
        <h2>لأن هدفنا إنك تبلّش، مش إنك تدوّر</h2>
        <p>
          أكتر شي بيوقف الطالب مش الفكرة — القطعة. تلاقي المشروع، وبعدها تضيع أسبوع تسأل مين بيبيع الحساس،
          وتطلع من محل لمحل، وتشتري غلط وترجع تشتري.
        </p>
        <p>
          عشان هيك عندنا متجرنا. <b>{ar(count)} قطعة</b> بـ<b>{ar(cats)} قسم</b>، أسعارها مكتوبة قدامك،
          ومربوطة بقوائم مشاريعنا: بتفتح المشروع، بتلاقي قطعه جاهزة بأسعارها، وبتطلبها كلها بضغطة.
        </p>
        <p class="sig">— فريق مشاريع</p>

        <div class="acts">
          <a class="pill" href="/store">ادخل المتجر <i>←</i></a>
          <a class="ghost" href="#projects">أو شوف مشروعاً بقطعه</a>
        </div>
      </div>

      <ul class="pts">
        <li><span set:html={svg('store', 18)} /><div><b>أسعار واضحة</b><span>بلا مفاجآت ولا سؤال عن السعر</span></div></li>
        <li><span set:html={svg('box', 18)} /><div><b>مربوط بالمشاريع</b><span>قطع كل مشروع بسعرها الحالي</span></div></li>
        <li><span set:html={svg('phone', 18)} /><div><b>الطلب بواتساب</b><span>بتأكد سلتك برسالة وحدة</span></div></li>
        <li><span set:html={svg('flask', 18)} /><div><b>بدائل لكل قطعة</b><span>أرخص أو أدق، حسب ميزانيتك</span></div></li>
      </ul>
    </div>
  </div>
</section>

<style>
  .sn { background: var(--cream); padding: 20px 0 90px; position: relative; z-index: 1; }
  .box { position: relative; overflow: hidden; display: grid; grid-template-columns: 1.25fr 1fr; gap: clamp(24px, 4vw, 52px);
    background: var(--green); color: var(--cream); border-radius: 36px; padding: clamp(26px, 5vw, 54px);
    box-shadow: 0 0 0 1px rgba(61, 183, 166,.35), 0 40px 90px -50px rgba(10, 36, 72,.9); }
  .box::after { content: ''; position: absolute; inset-inline-end: -120px; top: -160px; width: 420px; height: 420px; border-radius: 50%;
    background: radial-gradient(circle, rgba(61, 183, 166,.5), transparent 70%); pointer-events: none; }

  .msg { position: relative; z-index: 1; }
  .k { display: inline-block; font-size: 12.5px; background: rgba(233, 243, 248,.14); padding: 5px 14px; border-radius: 999px; margin-bottom: 14px; }
  .msg h2 { font-size: clamp(26px, 4.4vw, 42px); line-height: 1.22; margin-bottom: 16px; }
  .msg p { line-height: 2.05; opacity: .84; margin-bottom: 12px; max-width: 52ch; }
  .msg b { color: var(--orange); opacity: 1; }
  .sig { font-size: 14px; opacity: .55 !important; margin-top: 4px; }

  .acts { display: flex; align-items: center; gap: 16px; flex-wrap: wrap; margin-top: 22px; }
  .acts .pill { color: var(--green); }
  .ghost { color: var(--cream); opacity: .75; font-size: 14.5px; text-decoration: none; border-bottom: 1px solid rgba(233, 243, 248,.3); padding-bottom: 2px; }
  .ghost:hover { opacity: 1; color: var(--orange); border-color: var(--orange); }

  .pts { position: relative; z-index: 1; list-style: none; display: grid; gap: 10px; align-content: center; }
  .pts li { display: flex; gap: 14px; align-items: flex-start; background: rgba(0,0,0,.18); border-radius: 20px; padding: 16px 18px; }
  .pts li > span { flex: none; width: 38px; height: 38px; border-radius: 12px; background: rgba(61, 183, 166,.22); color: var(--orange); display: grid; place-items: center; }
  .pts div { display: grid; gap: 2px; }
  .pts b { font-size: 15px; }
  .pts div span { font-size: 12.5px; opacity: .68; line-height: 1.65; }

  @media (max-width: 900px) {
    .sn { padding-bottom: 70px; }
    .box { grid-template-columns: 1fr; }
    .pts li { padding: 13px 15px; }
  }
</style>
