---
import Base from '../layouts/Base.astro';
import '../styles/community.css';
import { svg } from '../data/icons';
import { WHATSAPP, CONSULT_PRICE } from '../data/config';
const wa = `https://wa.me/${WHATSAPP}?text=${encodeURIComponent('مرحباً، بدي أستفسر عن مشاريع التخرج')}`;
---

<Base title="من نحن — مشاريع" description="مين إحنا، وشو منقدّم لطلاب مشاريع التخرج بالأردن.">
  <main class="pf about">
    <div class="container">
      <section class="say">
        <img class="mark" src="/img/tfc.png" alt="شعار The Four Coders" width="104" height="104" />
        <h1>من نحن</h1>
        <p class="o">نحنا طلاب متلكم، ومرّينا باللي بتمرّوا فيه: توهان وأسئلة متل «شو أعمل؟»، وفكرة اخترناها وهي أكبر من وقتنا، وقطعة اكتشفنا متأخر إنها مش موجودة بالأردن أصلاً.</p>
        <p>وبأكثر من مشروع عملناه صار عنا خبرة: نعرف شو بينفع وشو بيفشل، ومن وين تجيب القطعة وبكم. فبدل ما نحتفظ فيها، حوّلناها منصة — هدفها الأول إنه الطالب ما يعيش التوهان اللي بيقتل أي فكرة مميزة.</p>
        <p>وما بنبيع أفكار. الأفكار كلها مفتوحة ومجانية بتفاصيلها. بنوفّر الشي اللي بيأخّرك فعلاً: القطعة الصح من مورّد حقيقي بإربد، بديل أرخص لما تكون غالية، وحدا يرد عليك لما تتعقّد.</p>
        <p class="pull">المشروع شغلك إنت.<br />إحنا بس منشيل العقبات اللي مالها علاقة بشغلك.</p>
      </section>

      <h2 class="mid">شو بنقدّم</h2>
      <ol class="offer">
        <li>
          <span class="ic"><Fragment set:html={svg('box', 19)} /></span>
          <div><b>أفكار جاهزة ومجانية</b><p>الوصف والمكونات والتكلفة التقريبية مفتوحة للكل، بلا تسجيل.</p></div>
        </li>
        <li>
          <span class="ic"><Fragment set:html={svg('store', 19)} /></span>
          <div><b>القطع مجهّزة</b><p>سلة لكل مشروع بالبدائل والأسعار، بتطلبها بواتساب وبتوصلك.</p></div>
        </li>
        <li>
          <span class="ic"><Fragment set:html={svg('chat', 19)} /></span>
          <div><b>استشارة لمن يحتاجها</b><p>جلسة ومستند فيه المسار التقني وحلول التحديات، بـ{CONSULT_PRICE} د.أ. مش إلزامية.</p></div>
        </li>
        <li>
          <span class="ic"><Fragment set:html={svg('flask', 19)} /></span>
          <div><b>تعديل على المشروع</b><p>بدك تغيّر قطعة أو تضيف ميزة أو تبسّطه لميزانيتك؟ احكيلنا وبنرد بالسعر والمدة.</p></div>
        </li>
        <li>
          <span class="ic"><Fragment set:html={svg('building', 19)} /></span>
          <div><b>مجتمع لكل جامعة</b><p>تسأل زملاءك، تعرض شغلك، تدوّر على شريك، وتتابع مواعيد التسليم.</p></div>
        </li>
      </ol>

      <div class="c-card rules">
        <h2>شو ما بنعمله</h2>
        <ul>
          <li>ما بنعمل المشروع بدل الطالب، وما بنكتب كوداً جاهزاً للتسليم.</li>
          <li>ما بنوعدك بعلامة، الشغل شغلك والمناقشة مناقشتك.</li>
          <li>ما بنبيع بياناتك، وبريدك ورقمك الجامعي ما بيظهروا لأحد.</li>
        </ul>
      </div>

      <div class="c-card cta">
        <h2>عندك سؤال أو فكرة؟</h2>
        <p>احكيلنا فكرتك ولو ما لقيتها عندنا، بنشوف كيف نساعدك تنفّذها.</p>
        <div class="acts">
          <a class="pill" href={wa} target="_blank" rel="noopener">راسلنا على واتساب <i>←</i></a>
          <a class="c-btn ghost" href="/ambassador">كن سفيراً لجامعتك</a>
        </div>
      </div>
    </div>
  </main>
</Base>


<style is:global>
  .about .container { max-width: 900px; }
  .about h2 { font-size: 22px; margin: 34px 0 12px; color: var(--orange); } .about .c-card h2 { margin-top: 0; }

  .say { max-width: 58ch; margin: 0 auto; text-align: center; }
  .say h1 { margin: 0 0 18px; font-size: clamp(28px, 4.4vw, 36px); }
  .say h1::after { content: ''; display: block; width: 46px; height: 3px; border-radius: 3px; background: var(--orange); margin: 12px auto 0; }
  .say p { color: var(--fg-2); font-size: 16px; line-height: 1.85; margin: 0 0 13px; }
  .say .o { font-size: 18.5px; line-height: 1.8; color: var(--fg); }
  .say .o::first-letter { font-size: 1.1em; font-weight: 700; }
  .say .pull { margin: 22px 0 0; padding: 16px 0; font-size: 17.5px; line-height: 1.7; font-weight: 600; color: var(--fg);
    border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }

  .say .mark { width: 76px; height: 76px; border-radius: 50%; object-fit: cover; margin: 0 0 14px;
    box-shadow: 0 0 0 5px var(--bg), 0 0 0 6px var(--line), 0 16px 34px -18px rgba(0,0,0,.5); }
  @media (max-width: 560px) { .say .o { font-size: 17px; } .say p { font-size: 15.5px; } .say .pull { font-size: 16.5px; } }

  .about h2.mid { text-align: center; }
  .offer { list-style: none; padding: 0; margin: 0; display: grid; gap: 1px; background: var(--line);
    border: 1px solid var(--line); border-radius: 18px; overflow: hidden; }
  .offer li { display: flex; gap: 14px; align-items: flex-start; padding: 15px 18px; background: var(--bg); transition: background .18s; }
  .offer li:hover { background: var(--surface, var(--nv-surface)); }
  .offer .ic { width: 34px; height: 34px; flex: none; border-radius: 11px; background: var(--mint); color: var(--green);
    display: grid; place-items: center; }
  .offer b { font-size: 15.5px; display: block; }
  .offer p { margin: 3px 0 0; font-size: 14px; color: var(--fg-2); line-height: 1.7; }
  @media (max-width: 480px) { .offer li { padding: 17px 15px; gap: 13px; } }
  .about .rules { margin-top: 18px; } .about .rules ul { padding-inline-start: 19px; display: grid; gap: 4px; } .about .rules li { color: var(--fg-2); line-height: 1.75; font-size: 14.5px; }
  .about .cta h2 { color: var(--cream); }
  .about .cta { margin-top: 18px; background: var(--green); color: var(--cream); box-shadow: 0 0 0 1px rgba(232,116,59,.4), 0 0 50px -16px rgba(232,116,59,.35); }
  .about .cta p { opacity: .84; margin-bottom: 14px; }
  .about .cta .acts { display: flex; gap: 10px; flex-wrap: wrap; }
  .about .cta .pill { color: var(--green); } .about .cta .c-btn.ghost { color: var(--cream); box-shadow: inset 0 0 0 1px rgba(255,255,255,.3); text-decoration: none; }
</style>
