---
const tags = [
  { part: 'mcu', label: 'المتحكم الدقيق' },
  { part: 'usb', label: 'منفذ USB' },
  { part: 'head', label: 'دبابيس التوصيل' },
  { part: 'led', label: 'مؤشر الحالة' },
];
const caps = [
  { n: '٠١ — القطع', h: 'كل قطعة بسعرها ومكانها', p: 'شوف مكونات المشروع مفصّلة، مع بدائل أرخص وأدق لكل قطعة، قبل ما تدفع أي شيء.' },
  { n: '٠٢ — البناء', h: 'سلة جاهزة من متجر موثوق', p: 'بتجهّز سلتك وبتأكد الطلب بواتساب، وإحنا بنطلب من المورّد. وإذا احتجت المسار، عندنا استشارة.' },
  { n: '٠٣ — المناقشة', h: 'مشروع بيشتغل قدام اللجنة', p: 'لوحة متابعة حية بتثبت إن الفكرة شغالة، مع نصائح جاهزة لأسئلة المناقشة.', dash: true },
];
---

<section class="h3" id="hero3d">
  <div class="h3-stage">
    <div class="h3-title">
      <h1><span><b>من فكرة</b></span><span><b>إلى مناقشة</b></span></h1>
    </div>
    <canvas aria-hidden="true"></canvas>

    <div class="h3-sub"><a class="pill" href="#projects">استعرض المشاريع <i>←</i></a></div>

    {tags.map((t) => <div class="tag" data-part={t.part}><span>{t.label}</span></div>)}

    <div class="caps">
      {caps.map((c, i) => (
        <div class="cap" data-i={i + 1}>
          <div class="n">{c.n}</div>
          <h2>{c.h}</h2>
          <p>{c.p}</p>
          {c.dash && (
            <div class="dash">
              <div class="r"><span>وزن كيس المحلول</span><span>مباشر</span></div>
              <div class="bar"><i></i></div>
              <div class="ok"><b></b> النظام يعمل بشكل طبيعي</div>
            </div>
          )}
        </div>
      ))}
    </div>

    <div class="h3-prog"><i></i></div>
    <div class="h3-hint">مرّر للأسفل</div>
  </div>
</section>

<script>
  import { initHero } from '../scripts/hero3d';
  const root = document.getElementById('hero3d');
  if (root) initHero(root);
</script>

<style>
  .h3 { height: 560vh; position: relative; }
  .h3-stage {
    position: sticky; top: 0; height: 100vh; height: 100dvh; overflow: hidden;
    background: var(--cream); color: var(--fg);
    --fg: var(--green); --fg-2: #3f5c5c; --bgc: var(--cream);
  }
  canvas { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 1; pointer-events: none; }
  .h3-title {
    position: absolute; inset: 0; z-index: 0; display: grid; place-items: center;
    text-align: center; padding: 0 4vw; will-change: transform, opacity;
  }
  h1 { font-size: clamp(64px, 13.5vw, 220px); line-height: 0.98; font-weight: 700; letter-spacing: -0.02em; color: var(--fg); }
  h1 span { display: block; overflow: hidden; }
  h1 b { display: block; font-weight: 700; transform: translateY(105%); animation: rise 1.1s cubic-bezier(0.2, 0.9, 0.2, 1) forwards; }
  h1 span:nth-child(2) b { animation-delay: 0.14s; color: var(--orange); }
  @keyframes rise { to { transform: none; } }
  .h3-sub { position: absolute; z-index: 2; bottom: 6vh; inset-inline: 0; text-align: center; will-change: opacity, transform; }

  .tag {
    position: absolute; z-index: 3; transform: translate(-50%, -50%); opacity: 0; pointer-events: none;
    display: flex; align-items: center; gap: 10px; white-space: nowrap;
  }
  .tag::before { content: ''; width: 10px; height: 10px; border-radius: 50%; background: var(--orange); box-shadow: 0 0 0 5px rgba(232, 116, 59, 0.25); }
  .tag span { font-size: 13px; font-weight: 500; background: var(--fg); color: var(--bgc); padding: 6px 14px; border-radius: 999px; }

  .caps { position: absolute; z-index: 3; top: 50%; inset-inline-start: clamp(20px, 6vw, 90px); width: min(430px, 40vw); transform: translateY(-50%); pointer-events: none; }
  .cap { position: absolute; top: 50%; inset-inline: 0; transform: translateY(-40%); opacity: 0; transition: opacity 0.5s, transform 0.7s cubic-bezier(0.2, 0.8, 0.2, 1); }
  .cap.on { opacity: 1; transform: translateY(-50%); }
  .cap .n { font-size: 14px; letter-spacing: 0.14em; color: var(--orange); font-weight: 700; margin-bottom: 10px; }
  .cap h2 { font-size: clamp(32px, 4.4vw, 60px); line-height: 1.1; margin-bottom: 16px; color: var(--fg); }
  .cap p { font-size: clamp(15px, 1.6vw, 18px); line-height: 1.9; color: var(--fg-2); }
  .dash {
    margin-top: 26px; border-radius: 22px; padding: 20px 22px; color: var(--cream);
    background: rgba(255, 255, 255, 0.07); backdrop-filter: blur(14px);
    border: 1px solid rgba(232, 116, 59, 0.55);
    box-shadow: 0 0 34px rgba(232, 116, 59, 0.28), inset 0 0 30px rgba(232, 116, 59, 0.08);
  }
  .dash .r { display: flex; justify-content: space-between; font-size: 14px; opacity: 0.85; margin-bottom: 10px; }
  .bar { height: 10px; border-radius: 99px; background: rgba(255, 255, 255, 0.14); overflow: hidden; }
  .bar i { display: block; height: 100%; width: 72%; background: linear-gradient(90deg, var(--orange), #f5a26b); border-radius: 99px; animation: drain 6s ease-in-out infinite alternate; }
  @keyframes drain { from { width: 82%; } to { width: 34%; } }
  .dash .ok { display: inline-flex; gap: 8px; align-items: center; margin-top: 14px; font-size: 13px; }
  .dash .ok b { width: 8px; height: 8px; border-radius: 50%; background: #7fd69a; box-shadow: 0 0 10px #7fd69a; }

  .h3-prog { position: absolute; z-index: 4; inset-inline-end: clamp(16px, 3vw, 40px); top: 50%; transform: translateY(-50%); width: 3px; height: 120px; background: rgba(127, 127, 127, 0.25); border-radius: 9px; }
  .h3-prog i { position: absolute; inset-inline: 0; bottom: 0; background: var(--orange); border-radius: 9px; height: 0; }
  .h3-hint { position: absolute; z-index: 3; bottom: 2.5vh; left: 50%; transform: translateX(-50%); font-size: 12px; opacity: 0.55; color: var(--fg); transition: opacity 0.3s; }
  .no-webgl canvas { display: none; }

  @media (max-width: 760px) {
    .caps { top: auto; bottom: 112px; inset-inline: 16px; width: auto; transform: none; height: 190px; }
    .cap { top: auto; bottom: 0; transform: translateY(20px); }
    .cap.on { transform: none; }
    .cap h2 { font-size: 30px; margin-bottom: 8px; }
    .cap p { font-size: 14px; line-height: 1.7; }
    .dash { margin-top: 12px; padding: 14px; }
    .h3-sub { bottom: 112px; }
    .h3-prog { display: none; }
  }
</style>
