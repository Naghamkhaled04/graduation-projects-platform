---
import '../styles/community.css';
import { POINTS } from '../community/rules';
interface Props { project: string; title: string }
const { project, title } = Astro.props;
---

<section class="fbk wide" data-project={project} data-title={title}>
  <div class="head">
    <h2>تجارب الطلاب</h2>
    <div class="avg"><span class="c-stars" id="avg-stars"></span><b id="avg-num"></b><small id="avg-cnt"></small></div>
  </div>
  <p class="earn">علّق على الفكرة: <b>+{POINTS.ideaComment} نقطة</b>. أو شاركنا تجربتك مع صور من تنفيذك: <b>+{POINTS.photoFeedback} نقاط</b>. و{POINTS.redeemCost} نقطة = استشارة مجانية.</p>

  <div class="list c-list" id="fb-list"></div>

  <div class="c-card form">
    <h3>أضف تجربتك</h3>
    <div id="fb-auth"></div>
    <div id="fb-form" hidden>
      <div class="rate" id="fb-rate" role="radiogroup" aria-label="التقييم"></div>
      <label>تجربتك<textarea id="fb-text" rows="4" maxlength="800" placeholder="رأيك بالفكرة، أو شو نفّذت وشو واجهك وشو نصيحتك لغيرك؟ (١٠ أحرف على الأقل)"></textarea></label>
      <label>صور من تنفيذك للمشروع (اختياري، حتى ٣) — الصور بترفع النقاط من {POINTS.ideaComment} إلى {POINTS.photoFeedback}<input type="file" id="fb-files" accept="image/jpeg,image/png,image/webp" multiple /></label>
      <div class="c-thumbs" id="fb-thumbs"></div>
      <p class="c-err" id="fb-err"></p>
      <button type="button" class="c-btn" id="fb-send">أرسل التجربة</button>
      <p class="c-note">تجربتك بتظهر للجميع بعد مراجعتنا، ونقاطك بتنزل بعد الموافقة.</p>
    </div>
  </div>
</section>

<script>
  import { mountFeedback } from '../scripts/feedback';
  document.querySelectorAll<HTMLElement>('.fbk[data-project]').forEach((el) => { if (el.dataset.project) mountFeedback(el); });
</script>

<style is:global>
  .fbk { margin-top: 64px; }
  .fbk .head { display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 10px; }
  .fbk .avg { display: flex; gap: 8px; align-items: baseline; } .fbk .avg b { font-size: 22px; } .fbk .avg small { color: var(--fg-2); }
  .fbk .earn { color: var(--fg-2); margin: 8px 0 20px; line-height: 1.9; } .fbk .earn b { color: var(--orange); }
  .fbk .fb .top { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; margin-bottom: 8px; }
  .fbk .fb small { color: var(--fg-2); } .fbk .fb p { line-height: 1.9; color: var(--fg-2); }
  .fbk .sm { padding: 4px 12px; font-size: 12px; margin-inline-start: auto; }
  .fbk .form { margin-top: 20px; } .fbk .form h3 { margin-bottom: 12px; }
  .fbk .rate { display: flex; gap: 4px; margin-bottom: 12px; }
  .fbk .star { font-size: 30px; background: none; border: 0; cursor: pointer; color: rgba(14, 58, 99,.22); transition: transform .15s, color .15s; }
  .fbk .star.on, .fbk .star:hover { color: var(--orange); transform: scale(1.12); }
  @media (max-width: 480px) { .fbk .c-auth .row { display: grid; gap: 8px; } }
</style>
