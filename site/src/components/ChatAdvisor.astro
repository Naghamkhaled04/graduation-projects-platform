---
import { DOMAINS } from '../data/taxonomy';
import { svg } from '../data/icons';
---

<div class="bot" id="bot" hidden>
  <button type="button" class="bubble" aria-label="مستشار المشاريع"><span class="ic" set:html={svg('chat', 20)}></span><span class="tx">احكيلي فكرتك</span></button>
  <section class="win" hidden aria-label="مستشار المشاريع">
    <header><b>مستشار المشاريع</b><small>اسحبني من هون</small><button type="button" class="x" aria-label="إغلاق">×</button></header>
    <div class="msgs" aria-live="polite"></div>
    <div class="quick"></div>
    <form class="in"><input type="text" placeholder="اكتب فكرتك بجملة أو اثنتين…" autocomplete="off" maxlength="300" /><button type="submit" aria-label="إرسال">←</button></form>
  </section>
</div>
<script id="bot-domains" type="application/json" set:html={JSON.stringify(DOMAINS)}></script>

<script>
  import { advise, tagsOf, domainIcon, costNum, type Advice } from '../data/taxonomy';
  import { buildIndex, search, type SearchDoc, type Hit, type Index, type Verdict } from '../data/search';
  import { loadCatalog } from '../data/catalog';
  import { invokeFn } from '../projects/store';
  import { WHATSAPP } from '../data/config';
  import { svg } from '../data/icons';

  const root = document.getElementById('bot')!;
  const DOMS: { k: string; icon: string }[] = JSON.parse(document.getElementById('bot-domains')!.textContent!);
  const bubble = root.querySelector<HTMLElement>('.bubble')!, win = root.querySelector<HTMLElement>('.win')!;
  const msgs = root.querySelector<HTMLElement>('.msgs')!, quick = root.querySelector<HTMLElement>('.quick')!;
  const form = root.querySelector<HTMLFormElement>('.in')!, input = form.querySelector('input')!;
  const esc = (s: string) => s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
  const ar = (n: number) => n.toLocaleString('ar-EG');
  const latin = (s: string) => s.replace(/[٠-٩]/g, (c) => String('٠١٢٣٤٥٦٧٨٩'.indexOf(c)));
  root.hidden = false;

  /* ---------- سحب البالون/النافذة ---------- */
  const KEY = 'bot.pos.v1';
  let pos = { x: 20, y: innerHeight - 170 };
  try { const s = JSON.parse(localStorage.getItem(KEY) || 'null'); if (s) pos = s; } catch { /* اختياري */ }
  const place = () => {
    pos.x = Math.min(Math.max(8, pos.x), innerWidth - (bubble.offsetWidth || 70) - 8); pos.y = Math.min(Math.max(70, pos.y), innerHeight - 70 - (document.querySelector<HTMLElement>('.bnav')?.offsetHeight ?? 0));
    root.style.left = pos.x + 'px'; root.style.top = pos.y + 'px';
    root.classList.toggle('up', pos.y > innerHeight / 2); root.classList.toggle('right', pos.x > innerWidth / 2);
  };
  place(); addEventListener('resize', place);
  const drag = (handle: HTMLElement, onTap?: () => void) => {
    let sx = 0, sy = 0, ox = 0, oy = 0, moved = false, on = false;
    handle.addEventListener('pointerdown', (e) => { if ((e.target as HTMLElement).closest('.x')) return; on = true; moved = false; sx = e.clientX; sy = e.clientY; ox = pos.x; oy = pos.y; handle.setPointerCapture(e.pointerId); });
    handle.addEventListener('pointermove', (e) => { if (!on) return; const dx = e.clientX - sx, dy = e.clientY - sy; if (!moved && Math.hypot(dx, dy) < 5) return; moved = true; pos.x = ox + dx; pos.y = oy + dy; place(); });
    handle.addEventListener('pointerup', () => { if (!on) return; on = false; if (moved) { try { localStorage.setItem(KEY, JSON.stringify(pos)); } catch { /* اختياري */ } } else onTap?.(); });
  };
  const open = () => { win.hidden = false; bubble.hidden = true; if (!msgs.children.length) start(); input.focus({ preventScroll: true }); };
  const close = () => { win.hidden = true; bubble.hidden = false; };
  drag(bubble, open); drag(win.querySelector('header')!);
  win.querySelector('.x')!.addEventListener('click', close);

  /* ---------- الفهرس ---------- */
  let index: Index<SearchDoc> | null = null, docs: SearchDoc[] = [];
  const ensureIndex = async () => { if (!index) { docs = await loadCatalog(); index = buildIndex(docs); } return index!; };

  /* ---------- المحادثة ---------- */
  type Mode = 'idea' | 'g-dom' | 'g-exp' | 'g-bud';
  let mode: Mode = 'idea', idea = '', addMode = false, lastHits: Hit<SearchDoc>[] = [];
  const dom = new Set<string>(); let exp: 1 | 2 | 3 = 1;
  const say = (html: string, who: 'bot' | 'me' = 'bot') => { const d = document.createElement('div'); d.className = `m m-${who}`; d.innerHTML = html; msgs.appendChild(d); msgs.scrollTop = msgs.scrollHeight; return d; };
  const chips = (items: { t: string; html?: string; on?: boolean; go?: boolean; act: () => void }[]) => {
    quick.textContent = '';
    items.forEach((i) => { const b = document.createElement('button'); b.type = 'button'; b.className = 'q' + (i.on ? ' on' : '') + (i.go ? ' go' : ''); if (i.html) b.innerHTML = i.html; else b.textContent = i.t; b.addEventListener('click', i.act); quick.appendChild(b); });
  };
  const href = (d: SearchDoc) => (d.fromDb ? `/p?id=${encodeURIComponent(d.id)}` : `/projects/${d.id}`);
  const card = (h: Hit<SearchDoc>, i: number, best = false) => `<a class="rc${best ? ' best' : ''}" href="${href(h.doc)}">${best ? '<span class="badge">الأقرب لفكرتك</span>' : ''}<b>${ar(i + 1)}. ${esc(h.doc.title)}</b><span class="tg">${h.doc.tags.slice(0, 2).map((t) => `${svg(domainIcon(t), 13)} ${esc(t)}`).join(' · ')} · ${esc(h.doc.ln)}</span>${h.matched.length ? `<span class="why">وجدنا فيه: ${h.matched.slice(0, 4).map(esc).join('، ')}</span>` : ''}</a>`;
  const waIdea = () => `https://wa.me/${WHATSAPP}?text=${encodeURIComponent('مرحبا عندي فكرة مشروع وما لقيتها بالموقع:\n' + idea + '\nبدي استشارة لتنفيذها.')}`;

  function start() {
    mode = 'idea'; idea = ''; addMode = false; lastHits = []; dom.clear(); msgs.textContent = '';
    say('أهلاً احكيلي عن فكرتك بجملة أو اثنتين، وأنا بشوف إذا عندنا مشروع مثلها أو قريب منها.<br><small>مثلاً: «بدي جهاز ينبّه الممرض لما كيس المحلول يخلص»</small>');
    chips([
      { t: 'كيس المحلول يفضى', act: () => submit('بدي جهاز ينبه الممرض لما كيس المحلول يخلص') },
      { t: 'يسقي النبات لحاله', act: () => submit('نظام يسقي النبات لحاله حسب رطوبة التربة') },
      { t: 'إنذار لما يدخل حدا', act: () => submit('إنذار لما يدخل حدا على البيت وأنا مش موجود') },
      { t: 'ما عندي فكرة، ساعدني أختار', go: true, act: () => guided() },
    ]);
  }

  async function analyze(text: string) {
    const wait = say('لحظة، عم قارن فكرتك مع مشاريعنا…');
    const ix = await ensureIndex();
    const r = search(ix, text, 8);
    // طبقة فهم اختيارية (Claude عبر Supabase). إن لم تتوفر أو فشلت نكمل بالبحث المحلي
    let llm: { verdict: string; reply: string; picks: { id: string; why: string }[] } | null = null;
    if (r.verdict !== 'vague' && r.hits.length) {
      const d: any = await invokeFn('project-advisor', { query: text.slice(0, 400), candidates: r.hits.map((h) => ({ id: h.doc.id, title: h.doc.title, desc: h.doc.desc, tags: h.doc.tags, level: h.doc.ln })) });
      if (d && ['exists', 'close', 'none'].includes(d.verdict)) llm = d;
    }
    wait.remove();
    lastHits = r.hits;
    if (llm) { replyLLM(llm, r.hits); return; }
    reply(r.verdict, r.hits);
  }

  function replyLLM(l: { verdict: string; reply: string; picks: { id: string; why: string }[] }, hits: Hit<SearchDoc>[]) {
    if (l.reply) say(esc(l.reply));
    const picks = l.picks.map((p) => ({ h: hits.find((x) => x.doc.id === p.id), why: p.why })).filter((x): x is { h: Hit<SearchDoc>; why: string } => !!x.h);
    picks.forEach((p, i) => say(card({ ...p.h, matched: [] }, i, i === 0 && l.verdict === 'exists').replace('</a>', `<span class="why">${esc(p.why)}</span></a>`)));
    if (l.verdict === 'none' || !picks.length) say(`بنقدر نساعدك تنفّذ فكرتك: <a class="cta" href="${waIdea()}" target="_blank" rel="noopener">أرسل فكرتك لنا على واتساب ←</a>`);
    followUp();
  }
  function followUp() {
    chips([
      { t: 'حسب ميزانيتي', act: () => askBudget() },
      { t: 'زيد تفاصيل', act: () => { addMode = true; say('اكتب التفاصيل اللي بدك تضيفها لفكرتك وأنا بحدّث النتيجة.'); input.focus(); } },
      { t: 'فكرة جديدة', go: true, act: () => start() },
    ]);
  }

  function reply(v: Verdict, hits: Hit<SearchDoc>[]) {
    if (v === 'vague') {
      say('وصفك عام شوي احكيلي أكتر: <b>شو بدو يراقب أو يقيس أو يتحكم فيه؟</b> ولمين؟ (مثلاً: «مراقبة حرارة ثلاجة الأدوية بالصيدلية»)');
      chips([{ t: 'ساعدني أختار بأسئلة', go: true, act: () => guided() }]); return;
    }
    if (v === 'exists') {
      say('أيوه! عندنا مشروع بيطابق فكرتك:');
      say(card(hits[0], 0, true));
      const rest = hits.slice(1, 3).filter((h) => h.score >= hits[0].score * 0.85 && h.coverage >= 0.45);
      if (rest.length) { say('وفي كمان مشاريع قريبة منه:'); rest.forEach((h, i) => say(card(h, i + 1))); }
    } else if (v === 'close') {
      say('ما عندنا نفس فكرتك بالضبط، بس في مشاريع قريبة منها ممكن تكون نقطة بداية:');
      hits.filter((h, i) => i === 0 || h.matched.length >= 2).slice(0, 3).forEach((h, i) => say(card(h, i)));
      say('لو بدك نعدّل واحد منهم ليطابق فكرتك تماماً، هاي بالضبط شغلة الاستشارة.');
    } else {
      say('ما لقيت شي مثل فكرتك عندنا ممكن تكون فكرة جديدة ومميزة!');
      const near = hits.filter((h) => h.coverage >= 0.3 && h.matched.length >= 2).slice(0, 2);
      if (near.length) { say('أقرب شي عندنا (بس بعيد شوي):'); near.forEach((h, i) => say(card(h, i))); }
      say(`بنقدر نساعدك تنفّذ فكرتك: <a class="cta" href="${waIdea()}" target="_blank" rel="noopener">أرسل فكرتك لنا على واتساب ←</a>`);
    }
    chips([
      { t: 'حسب ميزانيتي', act: () => askBudget() },
      { t: 'زيد تفاصيل', act: () => { addMode = true; say('اكتب التفاصيل اللي بدك تضيفها لفكرتك وأنا بحدّث النتيجة.'); input.focus(); } },
      { t: 'فكرة جديدة', go: true, act: () => start() },
    ]);
  }

  /* ----- تضييق حسب الميزانية على نتائج الفكرة الحالية ----- */
  function askBudget() {
    say('كم ميزانيتك التقريبية للقطع؟ <small>اختر أو اكتب نطاق مثل «من ٣٠ إلى ٧٠»</small>');
    const pick = (b: Advice['budget'], t: string) => () => { say(esc(t), 'me'); applyBudget(b); };
    chips([{ t: 'أقل من ٥٠', act: pick({ min: 0, max: 50 }, 'أقل من ٥٠ د.أ') }, { t: 'بين ٥٠ و١٠٠', act: pick({ min: 50, max: 100 }, 'بين ٥٠ و١٠٠ د.أ') }, { t: 'أكثر من ١٠٠', act: pick({ min: 100, max: null }, 'أكثر من ١٠٠ د.أ') }, { t: 'مش مهم', act: pick(null, 'مش مهم') }]);
  }
  function applyBudget(b: Advice['budget']) {
    if (!b) { say('تمام، بدون قيد على الميزانية '); reply(lastHits.length ? 'close' : 'none', lastHits); return; }
    const ok = lastHits.filter((h) => { const c = costNum(h.doc.cost); return c >= b.min * 0.85 && (b.max == null || c <= b.max * 1.15); });
    if (!ok.length) { say('ما في مشاريع من نتائجك ضمن هالنطاق. جرّب نطاق أوسع أو احكيلي تفاصيل أكتر.'); askBudget(); return; }
    say('من نتائجك، هدول ضمن ميزانيتك:');
    ok.slice(0, 3).forEach((h, i) => say(card(h, i) + `<span class="why">التكلفة التقريبية: ${ar(costNum(h.doc.cost))} د.أ</span>`));
    chips([{ t: 'فكرة جديدة', go: true, act: () => start() }]);
  }
  const parseBudget = (t: string): Advice['budget'] | undefined => {
    const s = latin(t); if (/مش مهم|ما يفرق|بلا حد|مفتوح/.test(s)) return null;
    const n = [...s.matchAll(/\d+(?:\.\d+)?/g)].map((m) => Number(m[0])); if (!n.length || !/دينار|د\.أ|ميزاني|جنيه|\$|بين|من|حتى|اقل|أقل|اكثر|أكثر/.test(s)) return undefined;
    if (n.length >= 2) return { min: Math.min(n[0], n[1]), max: Math.max(n[0], n[1]) };
    return /أكثر|اكثر|اكتر|فوق|أعلى|اعلى/.test(s) ? { min: n[0], max: null } : { min: 0, max: n[0] };
  };

  /* ----- مسار "ساعدني أختار" (أسئلة) ----- */
  function guided() {
    mode = 'g-dom'; dom.clear(); say('تمام، بسألك ٣ أسئلة وبقترحلك. شو المجال اللي بيهمك؟ <small>(اختر واحد أو أكثر ثم «تمام»)</small>');
    const paint = () => chips([...DOMS.map((d) => ({ t: d.k, html: `${svg(d.icon, 15)} ${esc(d.k)}`, on: dom.has(d.k), act: () => { dom.has(d.k) ? dom.delete(d.k) : dom.add(d.k); paint(); } })), { t: dom.size ? 'تمام ←' : 'أي مجال ←', go: true, act: () => { say(esc(dom.size ? [...dom].join('، ') : 'أي مجال'), 'me'); gExp(); } }]);
    paint();
  }
  function gExp() {
    mode = 'g-exp'; say('كم خبرتك بمشاريع الإلكترونيات والبرمجة؟');
    const pick = (n: 1 | 2 | 3, t: string) => () => { exp = n; say(esc(t), 'me'); gBud(); };
    chips([{ t: 'أول مشروع إلي', act: pick(1, 'أول مشروع إلي') }, { t: 'عملت مشروع أو اثنين', act: pick(2, 'عملت مشروع أو اثنين') }, { t: 'خبرتي منيحة', act: pick(3, 'خبرتي منيحة') }]);
  }
  function gBud() {
    mode = 'g-bud'; say('وكم ميزانيتك التقريبية للقطع؟ <small>اختر أو اكتب نطاق</small>');
    const pick = (b: Advice['budget'], t: string) => () => { say(esc(t), 'me'); gResults(b); };
    chips([{ t: 'أقل من ٥٠', act: pick({ min: 0, max: 50 }, 'أقل من ٥٠ د.أ') }, { t: 'بين ٥٠ و١٠٠', act: pick({ min: 50, max: 100 }, 'بين ٥٠ و١٠٠ د.أ') }, { t: 'أكثر من ١٠٠', act: pick({ min: 100, max: null }, 'أكثر من ١٠٠ د.أ') }, { t: 'مش مهم', act: pick(null, 'مش مهم') }]);
  }
  async function gResults(budget: Advice['budget']) {
    mode = 'idea'; quick.textContent = ''; await ensureIndex();
    const a: Advice = { domains: [...dom], experience: exp, budget }; const tg = (p: any) => p.tags ?? tagsOf(p.id);
    let res = advise(docs as any[], a, tg), note = 'هدول أنسب المشاريع إلك:';
    if (!res.length && a.budget) { res = advise(docs as any[], a, tg, true); if (res.length) note = 'ما في مشاريع ضمن هالنطاق بهالمجال، هدول أقرب الخيارات:'; }
    if (!res.length) { res = advise(docs as any[], a, tg, true, true); if (res.length) note = 'كل مشاريع هالمجال أعلى من مستواك حالياً، هدول أقربها وبتحتاج معها مساعدة (وهاي شغلة الاستشارة):'; }
    if (!res.length) { say('ما لقيت مشروع بهالمواصفات. جرّب مجال ثاني أو نطاق أوسع، أو احكيلي فكرتك بجملة.'); chips([{ t: 'من جديد', go: true, act: () => start() }]); return; }
    say(esc(note)); lastHits = res.map((r) => ({ doc: r.p as SearchDoc, score: r.score, coverage: 1, matched: r.reasons.slice(0, 2) }));
    lastHits.forEach((h, i) => say(card(h, i)));
    chips([{ t: 'من جديد', go: true, act: () => start() }]);
  }

  /* ---------- الكتابة الحرّة ---------- */
  const SYN: Record<string, RegExp> = {
    'صحي': /صح|طب|مريض|مستشف|قلب|دواء|ادوية|أدوية/, 'زراعي': /زراع|مزرع|نبات|ماشي|نحل|مواشي/, 'طاقة': /طاق|كهرب|شمس|ألواح|الواح/,
    'سلامة وأمان': /سلام|أمان|امان|حماي|حريق|غاز|حراس|قفل/, 'مواصلات ونقل': /سيار|مرور|مواصل|نقل|طريق|سائق|موقف/, 'بيئة ومياه': /مياه|ميّاه|ماء|طقس|بيئ|هواء|سيول|خزان/,
    'بيوت ومدن ذكية': /بيت|منزل|مدين/, 'روبوتات ودرونات': /روبوت|درون|طائر|مسير/, 'صناعي وتشغيل': /مصنع|صناع|صيان|شحن|اهتزاز/, 'ذكاء اصطناعي وبرمجة': /ذكاء|برمج|صور|نص|ai/i,
  };
  async function submit(t: string) {
    t = t.trim(); if (!t) return; input.value = ''; say(esc(t), 'me'); quick.textContent = '';
    if (mode === 'g-dom') { Object.entries(SYN).forEach(([k, re]) => { if (re.test(t)) dom.add(k); }); DOMS.forEach((d) => { if (t.includes(d.k)) dom.add(d.k); }); if (!dom.size && !/أي|اي|مش مهم/.test(t)) { say('ما فهمت المجال. اختر من الأزرار أو اكتب مثل «زراعي» أو «مريض».'); return; } gExp(); return; }
    if (mode === 'g-exp') { exp = /خبير|متقدم|منيح|كتير|محترف|3|٣/.test(t) ? 3 : /متوسط|مشروع|اثنين|اتنين|2|٢/.test(t) ? 2 : 1; gBud(); return; }
    if (mode === 'g-bud') { const b = parseBudget(t); if (b === undefined) { say('اكتب نطاق مثل «من ٣٠ إلى ٧٠ دينار» أو «مش مهم».'); return; } gResults(b); return; }
    // وضع الفكرة: ميزانية لتضييق النتائج الحالية، وإلا وصف جديد/إضافي
    const b = lastHits.length ? parseBudget(t) : undefined;
    if (b !== undefined) { applyBudget(b); return; }
    idea = addMode && idea ? idea + ' ' + t : t; addMode = false;
    await analyze(idea);
  }
  form.addEventListener('submit', (e) => { e.preventDefault(); void submit(input.value); });
</script>

<style is:global>
  .bot { position: fixed; z-index: 60; width: 0; height: 0; }
  .bot [hidden] { display: none !important; }
  .bot .bubble { position: absolute; top: 0; left: 0; display: flex; align-items: center; gap: 8px; border: 0; cursor: grab; touch-action: none; padding: 12px 18px; border-radius: 999px; background: var(--green); color: var(--cream); font: 500 14px var(--font); white-space: nowrap; box-shadow: 0 0 0 1px rgba(61, 183, 166,.5), 0 0 30px rgba(61, 183, 166,.35), 0 14px 30px -10px rgba(10, 36, 72,.6); animation: botglow 3s ease-in-out infinite; }
  .bot .bubble:active { cursor: grabbing; } .bot .ic { font-size: 18px; }
  @keyframes botglow { 50% { box-shadow: 0 0 0 1px rgba(61, 183, 166,.8), 0 0 46px rgba(61, 183, 166,.6), 0 14px 30px -10px rgba(10, 36, 72,.6); } }
  .bot .win { position: absolute; width: min(380px, calc(100vw - 16px)); height: min(560px, calc(100vh - 100px)); display: flex; flex-direction: column; overflow: hidden; background: var(--cream); border-radius: 26px; box-shadow: 0 0 0 1px rgba(14, 58, 99,.1), 0 30px 70px -20px rgba(10, 36, 72,.6); top: 0; left: 0; }
  .bot.up .win { top: auto; bottom: 0; } .bot.right .win { left: auto; right: 0; }
  /* بالموبايل: النافذة تُثبَّت على الشاشة لا على مكان الفقاعة المسحوبة، وإلا انقصّت */
  @media (max-width: 560px) {
    .bot .win, .bot.up .win, .bot.right .win { position: fixed; inset: auto 8px 8px 8px; width: auto; height: min(78vh, 560px); }
  }
  .bot header { display: flex; align-items: center; gap: 10px; padding: 14px 18px; background: var(--green); color: var(--cream); cursor: grab; touch-action: none; user-select: none; }
