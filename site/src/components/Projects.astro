---
import { projects, levels } from '../data/projects';
import { DOMAINS, tagsOf } from '../data/taxonomy';
import { svg } from '../data/icons';

interface Props {
  /** بالرئيسية: عرض مختصر (أول N مشروع) بدون فلاتر، وزر لصفحة كل المشاريع */
  limit?: number;
}
const { limit } = Astro.props;
const list = limit ? projects.slice(0, limit) : projects;
const ar = (n: number) => n.toLocaleString('ar-EG');
---

<section class="pj" id="projects" data-limit={limit}>
  <div class="ambient-glow" style="top: 15%; right: 10%; width: 500px; height: 500px; background: radial-gradient(circle, rgba(61, 183, 166,0.12) 0%, transparent 70%);"></div>
  <div class="ambient-glow" style="bottom: 20%; left: 5%; width: 600px; height: 600px; background: radial-gradient(circle, rgba(28, 95, 119,0.10) 0%, transparent 70%);"></div>

  <div class="container" style="position: relative; z-index: 2;">
    <div class="pj-header">
      <span class="eyebrow"><i class="dot"></i>كتالوج شامل</span>
      <h2>مشاريع جاهزة لتبدأ فيها فوراً</h2>
      <p class="sub">الوصف والمكونات والتكلفة مجاناً. المسار والمخططات وحلول التحديات بالاستشارة.</p>
    </div>

    {!limit && <div class="filterbar glass-panel">
      <label>
        <span>المجال</span>
        <select id="f-dom">
          <option value="">كل المجالات ({projects.length})</option>
          {DOMAINS.map((d) => <option value={d.k}>{d.k} ({projects.filter((p) => tagsOf(p.id).includes(d.k)).length})</option>)}
        </select>
      </label>
      <label>
        <span>المستوى</span>
        <select id="f-lvl">
          <option value="">كل المستويات</option>
          {levels.map((l) => <option value={l}>{l} ({projects.filter((p) => p.ln === l).length})</option>)}
        </select>
      </label>
      <div class="count-badge" id="f-count" aria-live="polite"></div>
    </div>}

    <div class="grid">
      {list.map((p) => (
        <a class="card" href={`/projects/${p.id}`} data-lvl={p.ln} data-tags={tagsOf(p.id).join('|')}>
          <div class="thumb">
            <canvas data-id={p.id} aria-hidden="true"></canvas>
            <span class={`lvl ${p.l}`}>{p.ln}</span>
            {p.x && <span class="lock"><Fragment set:html={svg('lock', 13)} /> حصرية</span>}
          </div>
          <div class="cbody">
            <h3>{p.t}</h3>
            <p>{p.d}</p>
            <div class="tags">{p.p.map((t) => <span>{t}</span>)}</div>
            <div class="foot">
              <span class="go">استكشف التفاصيل <i class="arrow">←</i></span>
            </div>
          </div>
        </a>
      ))}
    </div>

    {limit && <div class="pj-more"><a class="pill" href="/projects"><span>شوف كل المشاريع ({ar(projects.length)})</span><i>←</i></a></div>}

    <div class="split">
      <div class="l">
        <span class="badge-tier">مجاني بالكامل</span>
        <h3>المحتوى الأساسي</h3>
        <p>الفكرة الواضحة، تحليل المشكلة، قائمة المكونات المعتمدة، والتكلفة الدقيقة من كتالوج المورّد.</p>
      </div>
      <div class="r">
        <span class="badge-tier premium">استشارة ٥ د.أ</span>
        <h3>المسار والتنفيذ</h3>
        <p>المسار البرمجي خطوة بخطوة، المكتبات المناسبة، مخطط التوصيل العملي، وحلول التحديات أمام اللجنة.</p>
      </div>
    </div>
  </div>
</section>

<script>
  import { initThumbs } from '../scripts/thumbs';
  import { loadRuntime, toCard } from '../projects/store';

  declare const gsap: any;
  declare const ScrollTrigger: any;

  (async () => {
    const grid = document.querySelector<HTMLElement>('.pj .grid');
    const first = grid?.querySelector<HTMLElement>('.card');
    try {
      const rt = await loadRuntime();
      const fill = (card: HTMLElement, p: ReturnType<typeof toCard>) => {
        card.setAttribute('href', `/p?id=${encodeURIComponent(p.id)}`); card.dataset.lvl = p.ln; card.dataset.tags = (p.tags ?? [p.c]).join('|');
        const lvl = card.querySelector<HTMLElement>('.lvl')!; lvl.textContent = p.ln; lvl.className = `lvl ${p.l}`;
        card.querySelector('h3')!.textContent = p.t; card.querySelector('.cbody p')!.textContent = p.d;
        const tags = card.querySelector('.tags')!; tags.textContent = ''; p.p.forEach((t) => { const s = document.createElement('span'); s.textContent = t; tags.appendChild(s); });
        card.querySelector<HTMLCanvasElement>('canvas')!.dataset.id = p.id;
      };
      rt.hidden.forEach((id) => grid?.querySelector<HTMLElement>(`.card canvas[data-id="${id}"]`)?.closest('.card')?.remove());
      rt.changed.forEach((d) => { const c = grid?.querySelector<HTMLElement>(`.card canvas[data-id="${d.id}"]`)?.closest<HTMLElement>('.card'); if (c) fill(c, toCard(d)); });
      const limited = grid?.closest<HTMLElement>('.pj')?.dataset.limit;
      if (first && grid && !limited) rt.added.forEach((d) => { const c = first.cloneNode(true) as HTMLElement; c.classList.remove('in'); c.hidden = false; fill(c, toCard(d)); const cv = c.querySelector('canvas')!; cv.classList.remove('ready'); grid.prepend(c); });
    } catch (e) { console.warn(e); }

    initThumbs([...document.querySelectorAll<HTMLCanvasElement>('.pj .thumb canvas')]);

    // GSAP ScrollTrigger Batch Animation for Cards
    if (typeof gsap !== 'undefined' && typeof ScrollTrigger !== 'undefined') {
      ScrollTrigger.batch('.pj .card', {
        interval: 0.1,
        batchMax: 6,
        onEnter: (batch: HTMLElement[]) => {
          gsap.fromTo(batch, 
            { opacity: 0, y: 35, scale: 0.97 },
            { opacity: 1, y: 0, scale: 1, duration: 0.7, stagger: 0.08, ease: 'power3.out', overwrite: 'auto' }
          );
        },
        once: true
      });
    } else {
      document.querySelectorAll<HTMLElement>('.pj .card').forEach((c) => c.classList.add('in'));
    }
  })();

  // فلترة مركّبة بقائمتين: المجال + المستوى
  const selDom = document.getElementById('f-dom') as HTMLSelectElement, selLvl = document.getElementById('f-lvl') as HTMLSelectElement;
  const applyFilter = () => {
    let shown = 0; const total = document.querySelectorAll('.pj .card').length;
    document.querySelectorAll<HTMLElement>('.pj .card').forEach((k) => {
      const tags = (k.dataset.tags ?? '').split('|');
      const isVisible = (!selDom.value || tags.includes(selDom.value)) && (!selLvl.value || k.dataset.lvl === selLvl.value);
      k.hidden = !isVisible;
      if (isVisible) shown++;
    });
    const c = document.getElementById('f-count');
    if (c) {
      if (selDom.value || selLvl.value) {
        c.textContent = `${shown.toLocaleString('ar-EG')} من ${total.toLocaleString('ar-EG')} مشروع`;
        c.classList.add('active');
      } else {
        c.textContent = '';
        c.classList.remove('active');
      }
    }
    // Re-refresh ScrollTrigger if present
    if (typeof ScrollTrigger !== 'undefined') ScrollTrigger.refresh();
  };
  // بالعرض المختصر (الرئيسية) ما في فلاتر
  if (selDom && selLvl) { selDom.addEventListener('change', applyFilter); selLvl.addEventListener('change', applyFilter); }

  addEventListener('projects:filter', (e) => {
    const d = (e as CustomEvent).detail ?? {};
    selDom.value = d.dom ?? '';
    selLvl.value = d.lvl ?? '';
    applyFilter();
  });
</script>

<style>
  .pj {
    background: var(--cream);
    padding: clamp(80px, 12vw, 140px) 0 100px;
    position: relative;
    z-index: 1;
    overflow: hidden;
  }
  .pj-header {
    text-align: center;
    max-width: 680px;
    margin: 0 auto 40px;
  }
  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    font-weight: 600;
    color: var(--orange);
    background: rgba(61, 183, 166, 0.1);
    border: 1px solid rgba(61, 183, 166, 0.25);
    padding: 5px 16px;
    border-radius: var(--radius-pill);
    margin-bottom: 16px;
    letter-spacing: 0.02em;
  }
  .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--orange);
    box-shadow: 0 0 8px var(--orange);
    animation: dotPulse 2s infinite ease-in-out;
  }
  @keyframes dotPulse {
    0%, 100% { transform: scale(1); opacity: 0.8; }
    50% { transform: scale(1.4); opacity: 1; }
  }
  h2 {
    font-size: clamp(32px, 5vw, 54px);
    line-height: 1.15;
    margin-bottom: 12px;
    color: var(--green);
    font-weight: 700;
    letter-spacing: -0.015em;
  }
  .sub {
    color: var(--fg-2);
    font-size: clamp(15px, 1.8vw, 18px);
    line-height: 1.8;
  }

  /* Filter bar */
  .filterbar {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    align-items: center;
    justify-content: center;
    margin: 0 auto 48px;
    padding: 16px 24px;
    border-radius: var(--radius-lg);
    max-width: 760px;
  }
  .filterbar label {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 13.5px;
    font-weight: 600;
    color: var(--fg-2);
  }
  .filterbar select {
    font: 500 14.5px var(--font);
    min-width: 190px;
    padding: 11px 36px 11px 16px;
    border-radius: var(--radius-sm);
    border: 1px solid rgba(14, 58, 99, 0.15);
    background: #ffffff;
    color: var(--green);
    cursor: pointer;
    outline: none;
    appearance: none;
    -webkit-appearance: none;
    background-image: linear-gradient(45deg, transparent 50%, var(--green) 50%), linear-gradient(135deg, var(--green) 50%, transparent 50%);
    background-position: calc(100% - 20px) 55%, calc(100% - 14px) 55%;
    background-size: 5px 5px;
    background-repeat: no-repeat;
    transition: all 0.25s ease;
  }
  [dir='rtl'] .filterbar select {
    background-position: 18px 55%, 12px 55%;
    padding: 11px 16px 11px 36px;
  }
  .filterbar select:hover {
    border-color: rgba(61, 183, 166, 0.5);
  }
  .filterbar select:focus {
    border-color: var(--orange);
    box-shadow: 0 0 0 3px rgba(61, 183, 166, 0.2);
  }
  .count-badge {
    font-size: 13px;
    font-weight: 600;
    color: var(--orange);
    padding: 6px 14px;
    border-radius: var(--radius-pill);
    background: rgba(61, 183, 166, 0.12);
    display: none;
  }
  .count-badge.active {
    display: inline-block;
  }

  /* Grid & Cards */
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(310px, 1fr));
    gap: 28px;
  }
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    text-decoration: none;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border: 1px solid rgba(14, 58, 99, 0.08);
    box-shadow: 0 10px 32px -12px rgba(10, 36, 72, 0.12);
    transition: transform 0.4s var(--ease-spring), box-shadow 0.4s var(--ease-spring), border-color 0.4s ease;
  }
  .card.in {
    opacity: 1;
    transform: none;
  }
  .card:hover {
    transform: translateY(-8px) scale(1.01);
    border-color: rgba(61, 183, 166, 0.45);
    box-shadow: 0 0 0 1px rgba(61, 183, 166, 0.4),
                0 0 36px rgba(61, 183, 166, 0.22),
                0 28px 64px -16px rgba(10, 36, 72, 0.26);
  }
  .thumb {
    position: relative;
    aspect-ratio: 16 / 10;
    background: radial-gradient(120% 90% at 50% 100%, #e6dac6 0%, var(--cream-2) 55%, var(--cream) 100%);
    overflow: hidden;
    border-bottom: 1px solid rgba(14, 58, 99, 0.06);
  }
  .thumb canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 0.6s ease, transform 0.6s var(--ease-spring);
  }
  .thumb canvas.ready {
    opacity: 1;
  }
  .card:hover .thumb canvas.ready {
    transform: scale(1.04);
  }

  .lvl {
    position: absolute;
    top: 14px;
    inset-inline-start: 14px;
    z-index: 2;
    font-size: 11.5px;
    font-weight: 600;
    padding: 4px 12px;
    border-radius: var(--radius-pill);
    background: var(--mint);
    color: var(--green);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
  }
  .lvl.m { background: #e5dcae; }
  .lvl.h { background: #bfe6df; color: #a43a18; }

  .lock {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    position: absolute;
    top: 14px;
    inset-inline-end: 14px;
    z-index: 2;
    font-size: 11.5px;
    font-weight: 600;
    background: rgba(255, 255, 255, 0.88);
    backdrop-filter: blur(6px);
    padding: 4px 11px;
    border-radius: var(--radius-pill);
    color: var(--orange);
    border: 1px solid rgba(61, 183, 166, 0.25);
  }

  .cbody {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 24px 26px;
  }
  h3 {
    font-size: 19.5px;
    font-weight: 700;
    line-height: 1.35;
    margin-bottom: 10px;
    color: var(--green);
    transition: color 0.25s ease;
  }
  .card:hover h3 {
    color: var(--orange);
  }
  p {
    color: var(--fg-2);
    font-size: 14px;
    line-height: 1.8;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 16px;
  }
  .tags span {
    font-size: 11.5px;
    font-weight: 500;
    padding: 4px 11px;
    border-radius: var(--radius-pill);
    background: var(--cream-2);
    color: var(--fg-2);
  }
  .foot {
    display: flex;
    justify-content: flex-start;
    align-items: center;
    margin-top: auto;
    padding-top: 18px;
    border-top: 1px solid rgba(14, 58, 99, 0.08);
  }
  .go {
    color: var(--orange);
    font-size: 14px;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: gap 0.25s ease;
  }
  .card:hover .go {
    gap: 12px;
  }
  .arrow {
    font-style: normal;
    transition: transform 0.25s ease;
  }
  .card:hover .arrow {
    transform: translateX(-4px);
  }

  /* Split Banner — Contrast Box */
  .pj-more { display: flex; justify-content: center; margin: 34px 0 10px; }
  .split {
    margin: 90px auto 0;
    max-width: 1040px;
    border-radius: var(--radius-lg);
    overflow: hidden;
    display: grid;
    grid-template-columns: 1fr 1fr;
    box-shadow: 0 0 0 1px rgba(14, 58, 99, 0.1), 0 30px 70px -20px rgba(10, 36, 72, 0.25);
  }
  .split div {
    padding: clamp(32px, 5vw, 48px);
    font-size: 16px;
    line-height: 1.85;
  }
  .split .l {
    background: #ffffff;
    color: var(--green);
  }
  .split .r {
    background: var(--green-2);
    color: var(--cream);
    position: relative;
  }
  .badge-tier {
    display: inline-block;
    font-size: 12.5px;
    font-weight: 600;
    padding: 4px 14px;
    border-radius: var(--radius-pill);
    background: var(--cream-2);
    color: var(--green);
    margin-bottom: 14px;
  }
  .badge-tier.premium {
    background: var(--orange);
    color: #fff;
    box-shadow: 0 4px 16px rgba(61, 183, 166, 0.4);
  }
  .split h3 {
    font-size: 24px;
    margin-bottom: 10px;
  }
  .split .r h3 {
    color: var(--cream);
  }
  .split p {
    color: inherit;
    opacity: 0.85;
    font-size: 15px;
    display: block;
    line-clamp: unset;
    -webkit-line-clamp: unset;
  }

  @media (max-width: 760px) {
    .split {
      grid-template-columns: 1fr;
    }
    .filterbar {
      flex-direction: column;
      align-items: stretch;
    }
    .filterbar label {
      flex-direction: column;
      align-items: stretch;
    }
    .filterbar select {
      width: 100%;
    }
  }
</style>
