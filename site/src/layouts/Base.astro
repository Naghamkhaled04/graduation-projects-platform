---
import '../styles/global.css';
import Header from '../components/Header.astro';
import ChatAdvisor from '../components/ChatAdvisor.astro';
import WhatsAppFab from '../components/WhatsAppFab.astro';
import Footer from '../components/Footer.astro';
import guardSrc from '../scripts/guard.js?raw';
import { inlineGuard } from '../scripts/guard-inline.js';

interface Props {
  title: string;
  description?: string;
  /** صفحة مفتوحة بدون تسجيل دخول */
  isPublic?: boolean;
  /** بدون الهيدر والمساعد والواتساب والفوتر (صفحة التعريف) */
  bare?: boolean;
}
const { title, description = 'مشاريع تخرج لطلاب الحاسوب وإنترنت الأشياء: أفكار، قطع، وسلة جاهزة.', isPublic = false, bare = false } = Astro.props;
const guard = inlineGuard(guardSrc);
const path = Astro.url.pathname.replace(/\/$/, '');
const chrome = !bare && !['/city', '/admin'].includes(path);
---

<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="utf-8" />
    {!isPublic && <script is:inline set:html={guard}></script>}
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <!-- GSAP & ScrollTrigger — محرك الحركة السينمائية -->
    <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
    <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>
  </head>
  <body>
    {!bare && <Header />}
    <slot />
    {chrome && <ChatAdvisor />}
    {chrome && <WhatsAppFab />}
    {chrome && <Footer />}

    <script is:inline>
      // تسجيل إضافة ScrollTrigger فور جاهزية الصفحة
      if (typeof gsap !== 'undefined' && typeof ScrollTrigger !== 'undefined') {
        gsap.registerPlugin(ScrollTrigger);
        // تكوين إعدادات افتراضية ناعمة
        ScrollTrigger.config({ limitCallbacks: true, ignoreMobileResize: true });
      }
    </script>
  </body>
</html>
