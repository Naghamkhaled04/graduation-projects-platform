---
import Base from '../../layouts/Base.astro';
import '../../styles/store.css';
import Basket from '../../components/Basket.astro';
import HeroBoards from '../../components/HeroBoards.astro';
import Boards from '../../components/Boards.astro';
import CatStrip from '../../components/CatStrip.astro';
import { CATEGORIES, PRODUCTS, SERVICES, ar } from '../../data/storecats';
import { usedBy } from '../../data/projectparts';
import { svg } from '../../data/icons';
import { WHATSAPP } from '../../data/config';

const wa = `https://wa.me/${WHATSAPP}?text=${encodeURIComponent('مرحباً، بدي أستفسر عن قطعة مش لاقيها بالمتجر')}`;
const linked = PRODUCTS.filter((p) => usedBy(p.id).length).length;
---

<Base title="المتجر — مشاريع" description={`${ar(PRODUCTS.length)} قطعة إلكترونيات بأسعارها: متحكمات، حساسات، محركات، شاشات وأكثر.`}>
  <main class="nv">
    <div class="wrap">
      <section class="nv-find">
        <h1>كل قطع مشروعك، بمكان واحد</h1>
        <form class="nv-find__bar" action="/store/all" role="search">
          <span class="nv-find__ic" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg></span>
          <input type="search" name="q" placeholder="ابحث… ESP32، حساس حرارة، محرك" aria-label="ابحث بالمتجر" autocomplete="off" enterkeyhint="search" />
          <button type="submit">ابحث</button>
        </form>
        <p class="nv-find__meta"><b>{ar(PRODUCTS.length)}</b> قطعة · <b>{ar(CATEGORIES.length)}</b> قسم · <b>{ar(linked)}</b> مربوطة بمشاريعنا</p>
        <nav class="nv-chips" aria-label="الأقسام">
          {CATEGORIES.slice(0, 8).map((c) => <a href={`/store/${c.slug}`}><Fragment set:html={svg(c.icon, 16)} />{c.cat}</a>)}
          <a class="all" href="/store/all">كل الأقسام</a>
        </nav>
      </section>

      <CatStrip />

      <Boards />

      <section class="nv-sec">
        <h2>خدماتنا</h2>
        <p>مش بس قطع — إحنا بننفّذ كمان.</p>
        <div class="nv-srv">
          {SERVICES.map((s) => (
            <div>
              <span class="ic"><Fragment set:html={svg(s.icon, 19)} /></span>
              <b>{s.t}</b>
              <p>{s.d}</p>
            </div>
          ))}
        </div>
      </section>

      <div class="nv-cta">
        <div><b>ما لقيت القطعة اللي بدك إياها؟</b><p>احكيلنا وبنجيبها لك بالطلب.</p></div>
        <a class="nv-btn" href={wa} target="_blank" rel="noopener">اطلبها منّا</a>
      </div>
    </div>

    <Basket />
  </main>
</Base>
