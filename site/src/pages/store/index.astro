---
import Base from '../../layouts/Base.astro';
import '../../styles/store.css';
import Basket from '../../components/Basket.astro';
import HeroBoards from '../../components/HeroBoards.astro';
import Boards from '../../components/Boards.astro';
import ProdCard from '../../components/ProdCard.astro';
import CatStrip from '../../components/CatStrip.astro';
import { CATEGORIES, PRODUCTS, FEATURED, SERVICES, ar } from '../../data/storecats';
import { usedBy } from '../../data/projectparts';
import { svg } from '../../data/icons';
import { WHATSAPP } from '../../data/config';

const wa = `https://wa.me/${WHATSAPP}?text=${encodeURIComponent('مرحباً، بدي أستفسر عن قطعة مش لاقيها بالمتجر')}`;
const linked = PRODUCTS.filter((p) => usedBy(p.id).length).length;
---

<Base title="المتجر — مشاريع" description={`${ar(PRODUCTS.length)} قطعة إلكترونيات بأسعارها: متحكمات، حساسات، محركات، شاشات وأكثر.`}>
  <main class="nv">
    <div class="wrap">
      <section class="nv-hero">
        <div class="in">
          <span class="k">المتجر</span>
          <h1>كل قطع مشروعك، بمكان واحد</h1>
          <p>
            <b>{ar(PRODUCTS.length)} قطعة</b> بأسعارها مكتوبة قدامك، مقسّمة على <b>{ar(CATEGORIES.length)} قسم</b>.
            و<b>{ar(linked)} قطعة</b> منها مربوطة بمشاريعنا، فبتعرف ليش بتشتريها وبأي مشروع بتنستعمل.
          </p>
          <form class="nv-search" action="/store/all">
            <input type="search" name="q" placeholder="ابحث… (ESP32، حساس حرارة، محرك)" aria-label="ابحث بالمتجر" />
            <button type="submit">ابحث</button>
          </form>
        </div>
        <div class="nv-stats">
          <div><b>{ar(PRODUCTS.length)}</b><span>قطعة</span></div>
          <div><b>{ar(CATEGORIES.length)}</b><span>قسم</span></div>
          <div><b>{ar(linked)}</b><span>مربوطة بمشاريعنا</span></div>
        </div>
      </section>

      <section class="nv-sec">
        <h2>قطع بيبلّش فيها الكل</h2>
        <p>أرخص خيار من كل قسم أساسي.</p>
        <div class="nv-grid">
          {FEATURED.map((p) => <ProdCard p={p} used={usedBy(p.id)} />)}
        </div>
      </section>

      <Boards />

      <CatStrip />

      <section class="nv-sec">
        <h2>خدماتنا</h2>
        <p>مش بس قطع — إحنا بننفّذ كمان.</p>
        <div class="nv-srv">
          {SERVICES.map((s) => (
            <div>
              <span class="ic"><Fragment set:html={svg(s.icon, 19)} /></span>
              <b>{s.t}</b>
              <p>{s.d}</p>
            </div>
          ))}
        </div>
      </section>

      <div class="nv-cta">
        <div><b>ما لقيت القطعة اللي بدك إياها؟</b><p>احكيلنا وبنجيبها لك بالطلب.</p></div>
        <a class="nv-btn" href={wa} target="_blank" rel="noopener">اطلبها منّا</a>
      </div>
    </div>

    <Basket />
  </main>
</Base>
