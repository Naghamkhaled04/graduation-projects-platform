---
import { slugOf, ar, imgFallback } from '../data/storecats';
interface Props { p: { id: string; nm: string; cat: string; p: number; img: string }; used?: { id: string; t: string }[] }
const { p, used = [] } = Astro.props;
const IMG = '/img/part.svg';
const href = `/store/${slugOf(p.cat)}#p-${p.id}`;
---

<article class="nv-card" id={`p-${p.id}`} data-id={p.id} data-nm={p.nm} data-price={p.p} data-img={p.img}
  data-cat={p.cat} data-used={used.length} data-search={(p.nm + ' ' + p.cat).toLowerCase()}>
  <a class="nv-card__media" href={href}>
    <img src={p.img || IMG} alt={p.nm} onerror={imgFallback} loading="lazy" decoding="async" width="240" height="240" />
  </a>
  <div class="nv-card__body">
    <span class="nv-card__tag">{p.cat}</span>
    <h3 class="nv-card__title"><a href={href}>{p.nm}</a></h3>
    {used.length > 0 && (
      <span class="nv-card__used">بمشروع: <a href={`/projects/${used[0].id}`}>{used[0].t}</a>{used.length > 1 && ` و${ar(used.length - 1)} غيره`}</span>
    )}
    <div class="nv-card__foot">
      <span class="nv-card__price">{ar(p.p)} د.أ</span>
      <button type="button" class="nv-btn add">أضف للسلة</button>
    </div>
  </div>
</article>
