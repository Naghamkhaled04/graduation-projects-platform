---
const tags = [
  { part: 'mcu', label: 'المتحكم الدقيق (ESP32 / MCU)' },
  { part: 'usb', label: 'منفذ البرمجة والطاقة USB' },
  { part: 'head', label: 'دبابيس التوصيل GPIO' },
  { part: 'led', label: 'مؤشر الحالة والتشغيل' },
];
const caps = [
  { n: '٠١ — المكونات والقطع', h: 'كل قطعة بسعرها ومكانها بدقة', p: 'استكشف مكونات المشروع مفصّلة بالكامل، مع بدائل أرخص وأدق لكل قطعة من المورّد المعتمد، قبل أن تبدأ بالتنفيذ.' },
  { n: '٠٢ — البناء والتوصيل', h: 'سلة جاهزة بنقرة واحدة عبر واتساب', p: 'بتجهّز سلتك وبتأكد الطلب فوراً، وإحنا بنطلب من المورّد. وإذا احتجت مخطط التوصيل والمسار البرمجي، استشارتنا معك خطوة بخطوة.' },
  { n: '٠٣ — المناقشة والجاهزية', h: 'مشروع حقيقي بيشتغل قدام اللجنة', p: 'لوحة تحكم حية بتثبت إن الفكرة شغالة بكفاءة، مع إجابات نموذجية ونقاط قوة مسبقة لأصعب أسئلة اللجنة.', dash: true },
];
---

<section class="h3" id="hero3d">
  <div class="h3-stage">
    <div class="h3-title">
      <h1>
        <span class="word-1"><b>من فكرة مشروع</b></span>
        <span class="word-2"><b>إلى مناقشة ناجحة</b></span>
      </h1>
      <p class="h3-lead">أول منصة متكاملة لمشاريع تخرج الحاسوب والـ IoT بالأردن: مكونات حقيقية، سلة جاهزة، ودعم فني للمناقشة.</p>
    </div>
    <canvas aria-hidden="true"></canvas>

    <div class="h3-sub">
      <a class="pill" href="#projects">
        <span>استعرض المشاريع الجاهزة</span>
        <i>←</i>
      </a>
    </div>

    {tags.map((t) => (
      <div class="tag" data-part={t.part}>
        <span class="tag-pin"></span>
        <span class="tag-label">{t.label}</span>
      </div>
    ))}

    <div class="caps">
      {caps.map((c, i) => (
        <div class="cap" data-i={i + 1}>
          <div class="n"><span class="badge-n">{c.n}</span></div>
          <h2>{c.h}</h2>
          <p>{c.p}</p>
          {c.dash && (
            <div class="dash">
              <div class="r"><span>مراقبة حية للمشروع</span><span class="live-pill">مباشر ●</span></div>
              <div class="bar"><i></i></div>
              <div class="ok"><b></b> جميع الحساسات والمتحكم تعمل بكفاءة ١٠٠٪</div>
            </div>
          )}
        </div>
      ))}
    </div>

    <div class="h3-prog" title="مستوى التقدم في العرض"><i></i></div>
    <div class="h3-hint">مرّر للأسفل لاستكشاف البوردة والمشروع ↓</div>
  </div>
</section>

<script>
  import { initHero } from '../scripts/hero3d';
  const root = document.getElementById('hero3d');
  if (root) initHero(root);
</script>

<style>
  .h3 {
    height: 560vh;
    position: relative;
  }
  .h3-stage {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100dvh;
    overflow: hidden;
    background: var(--cream);
    color: var(--fg);
    --fg: var(--green);
    --fg-2: #3f5c5c;
    --bgc: var(--cream);
  }
  /* شبكة خفيفة + وهج نيون بطيء (مستوحى من 6sense). على pseudo لأن hero3d.ts بيكتب stage.style.background */
  .h3-stage::before,
  .h3-stage::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1; /* sticky = stacking context، فبتضل تحت العنوان وفوق الخلفية */
    pointer-events: none;
  }
  .h3-stage::before {
    --line: color-mix(in srgb, var(--fg) 8%, transparent);
    background:
      linear-gradient(var(--line) 1px, transparent 1px) 0 0 / 56px 56px,
      linear-gradient(90deg, var(--line) 1px, transparent 1px) 0 0 / 56px 56px;
    mask-image: radial-gradient(ellipse 75% 65% at 50% 45%, #000 30%, transparent 100%);
    /* ثابتة: حركة الخلفية مع الماسك كانت تعيد رسم الشاشة كلها كل فريم */
  }
  .h3-stage::after {
    background:
      radial-gradient(circle at 30% 35%, rgba(61, 183, 166, 0.22), transparent 42%),
      radial-gradient(circle at 72% 60%, rgba(28, 95, 119, 0.16), transparent 45%);
    /* ثابت وبلا blur: طبقة بكامل الشاشة بتكبر وتصغر كانت تنعاد رسمتها كل فريم وتبطّئ السكرول */
  }
  canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    pointer-events: none;
  }
  .h3-title {
    position: absolute;
    inset: 0;
    z-index: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 0 4vw;
    will-change: transform, opacity;
  }
  h1 {
    font-size: clamp(48px, 10.5vw, 150px);
    line-height: 1.05;
    font-weight: 700;
    letter-spacing: -0.025em;
    color: var(--fg);
    margin-bottom: 20px;
  }
  h1 span {
    display: block;
    overflow: hidden;
  }
  h1 b {
    display: block;
    font-weight: 700;
    transform: translateY(105%);
    animation: rise 1.1s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
  .word-2 b {
    animation-delay: 0.16s;
    color: var(--orange);
    text-shadow: 0 0 45px rgba(61, 183, 166, 0.3);
  }
  @keyframes rise {
    to { transform: none; }
  }

  .h3-lead {
    font-size: clamp(16px, 2vw, 22px);
    color: var(--fg-2);
    max-width: 620px;
    margin: 0 auto;
    line-height: 1.85;
    opacity: 0;
    animation: fadeIn 1.2s ease 0.4s forwards;
  }
  @keyframes fadeIn {
    to { opacity: 0.95; }
  }

  .h3-sub {
    position: absolute;
    z-index: 2;
    bottom: 7vh;
    inset-inline: 0;
    text-align: center;
    will-change: opacity, transform;
  }

  /* Interactive PCB 3D Tags */
  .tag {
    position: absolute;
    z-index: 3;
    transform: translate(-50%, -50%);
    opacity: 0;
    pointer-events: none;
    display: flex;
    align-items: center;
    gap: 12px;
    white-space: nowrap;
    transition: opacity 0.3s ease;
  }
  .tag-pin {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--orange);
    box-shadow: 0 0 0 4px rgba(61, 183, 166, 0.3), 0 0 16px var(--orange);
    position: relative;
  }
  .tag-pin::after {
    content: '';
    position: absolute;
    inset: -6px;
    border-radius: 50%;
    border: 1px solid var(--orange);
    animation: pinRadar 2s infinite ease-out;
  }
  @keyframes pinRadar {
    0% { transform: scale(0.6); opacity: 1; }
    100% { transform: scale(2.2); opacity: 0; }
  }
  .tag-label {
    font-size: 13.5px;
    font-weight: 600;
    background: rgba(10, 36, 72, 0.92);
    color: #f3f6f8;
    padding: 7px 18px;
    border-radius: var(--radius-pill);
    border: 1px solid rgba(61, 183, 166, 0.4);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.25);
  }

  /* Captions on Scroll */
  .caps {
    position: absolute;
    z-index: 3;
    top: 50%;
    inset-inline-start: clamp(20px, 6vw, 90px);
    width: min(460px, 42vw);
    transform: translateY(-50%);
    pointer-events: none;
  }
  .cap {
    position: absolute;
    top: 50%;
    inset-inline: 0;
    transform: translateY(-40%);
    opacity: 0;
    transition: opacity 0.5s ease, transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .cap.on {
    opacity: 1;
    transform: translateY(-50%);
  }
  .cap .n {
    margin-bottom: 14px;
  }
  .badge-n {
    display: inline-block;
    font-size: 13px;
    letter-spacing: 0.08em;
    color: var(--orange);
    font-weight: 700;
    background: rgba(61, 183, 166, 0.12);
    border: 1px solid rgba(61, 183, 166, 0.3);
    padding: 4px 14px;
    border-radius: var(--radius-pill);
  }
  .cap h2 {
    font-size: clamp(32px, 4.4vw, 56px);
    line-height: 1.15;
    margin-bottom: 16px;
    color: var(--fg);
    font-weight: 700;
  }
  .cap p {
    font-size: clamp(15px, 1.6vw, 18px);
    line-height: 1.9;
    color: var(--fg-2);
  }

  .dash {
    margin-top: 26px;
    border-radius: 22px;
    padding: 20px 24px;
    color: var(--cream);
    background: rgba(10, 36, 72, 0.92);
    border: 1px solid rgba(61, 183, 166, 0.5);
    box-shadow: 0 0 35px rgba(61, 183, 166, 0.25), inset 0 0 30px rgba(61, 183, 166, 0.08);
  }
  .dash .r {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 14px;
    opacity: 0.9;
    margin-bottom: 12px;
  }
  .live-pill {
    color: #7fd69a;
    font-size: 12px;
    font-weight: 700;
  }
  .bar {
    height: 10px;
    border-radius: 99px;
    background: rgba(255, 255, 255, 0.16);
    overflow: hidden;
  }
  .bar i {
    display: block;
    height: 100%;
    width: 78%;
    background: linear-gradient(90deg, var(--orange), #7fd8cb);
    border-radius: 99px;
    animation: drain 6s ease-in-out infinite alternate;
  }
  @keyframes drain {
    from { width: 88%; }
    to { width: 42%; }
  }
  .dash .ok {
    display: inline-flex;
    gap: 8px;
    align-items: center;
    margin-top: 14px;
    font-size: 13.5px;
  }
  .dash .ok b {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #7fd69a;
    box-shadow: 0 0 10px #7fd69a;
  }

  .h3-prog {
    position: absolute;
    z-index: 4;
    inset-inline-end: clamp(16px, 3vw, 40px);
    top: 50%;
    transform: translateY(-50%);
    width: 4px;
    height: 140px;
    background: rgba(127, 127, 127, 0.2);
    border-radius: 9px;
  }
  .h3-prog i {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    background: var(--orange);
    box-shadow: 0 0 12px var(--orange);
    border-radius: 9px;
    height: 0;
  }
  .h3-hint {
    position: absolute;
    z-index: 3;
    bottom: 2.2vh;
    left: 50%;
    transform: translateX(-50%);
    font-size: 13px;
    opacity: 0.65;
    color: var(--fg);
    transition: opacity 0.3s;
    font-weight: 500;
  }

  @media (max-width: 760px) {
    .caps {
      top: auto;
      bottom: 112px;
      inset-inline: 16px;
      width: auto;
      transform: none;
      height: 200px;
    }
    .cap {
      top: auto;
      bottom: 0;
      transform: translateY(20px);
    }
    .cap.on {
      transform: none;
    }
    .cap h2 {
      font-size: 28px;
      margin-bottom: 8px;
    }
    .cap p {
      font-size: 14px;
      line-height: 1.7;
    }
    .dash {
      margin-top: 10px;
      padding: 14px;
    }
    .h3-sub {
      bottom: 112px;
    }
    .h3-prog {
      display: none;
    }
  }
  /* كل اللي بيتحرّك بالسكرول على طبقة لحاله، فما بتنعاد رسمة المسرح كله كل فريم */
  canvas, .tag, .caps, .cap, .h3-prog, .h3-prog i { will-change: transform; }
</style>
