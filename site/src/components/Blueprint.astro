---
// مشهد تمرير: الفكرة ← المخطط ← القطع ← المشروع (GSAP ScrollTrigger، scrub)
// الحالة الافتراضية بالـmarkup = المشروع المركّب، فبدون JS أو مع reduced-motion بيظهر الشكل النهائي.
const stages = [
  { h: 'كل مشروع بيبلش بفكرة', p: 'اختار فكرة من مكتبتنا أو احكيلنا فكرتك.' },
  { h: 'بنحوّلها لمخطط واضح', p: 'شو بيتصل بشو، وليش — قبل ما تشتري ولا قطعة.' },
  { h: 'كل قطعة بمكانها وسعرها', p: 'سلة جاهزة من المورّد المعتمد، بتأكدها عبر واتساب.' },
  { h: 'ومشروع متكامل قدام اللجنة', p: 'بيشتغل، ومعك أجوبة أصعب أسئلة المناقشة.' },
];
const labels = ['الفكرة', 'المخطط', 'القطع', 'المشروع'];
// [id, الاسم, مكان الانفجار (المرحلة ٣), مكان التركيب (المرحلة ٤)]
const parts = [
  { id: 'sensor', name: 'حساس المسافة', ex: [180, 170], as: [310, 215] },
  { id: 'screen', name: 'شاشة OLED', ex: [820, 170], as: [690, 215] },
  { id: 'relay', name: 'ريليه', ex: [820, 480], as: [690, 425] },
  { id: 'power', name: 'بطارية 9V', ex: [180, 480], as: [310, 425] },
  { id: 'mcu', name: 'المتحكم ESP32', ex: [500, 320], as: [500, 320] },
];
const wires = [
  'M255 170 H350 V290 H400',
  'M745 170 H650 V290 H600',
  'M745 480 H650 V350 H600',
  'M255 480 H350 V350 H400',
];
const traces = [
  'M385 215 H430 V290 H420',
  'M615 215 H570 V290 H580',
  'M615 425 H570 V350 H580',
  'M385 425 H430 V350 H420',
];
---

<section class="bp" id="how" data-parts={JSON.stringify(parts.map((p) => [p.id, p.ex, p.as]))}>
  <div class="bp-stage">
    <div class="bp-caps">
      {stages.map((s, i) => (
        <div class:list={['bp-cap', { on: i === 3 }]} data-i={i}>
          <h2>{s.h}</h2>
          <p>{s.p}</p>
        </div>
      ))}
    </div>

    <svg class="bp-svg" viewBox="0 0 1000 640" role="img" aria-label="من الفكرة إلى المخطط إلى القطع إلى مشروع متكامل">
      <!-- لوحة المشروع (المرحلة ٤) -->
      <g class="plate">
        <rect x="180" y="110" width="640" height="420" rx="28" fill="#0d4d5e" stroke="#3db7a6" stroke-opacity=".35" />
        <rect x="196" y="126" width="608" height="388" rx="20" fill="none" stroke="#3db7a6" stroke-opacity=".15" stroke-dasharray="2 10" />
      </g>
      <g class="traces">
        {traces.map((d) => <path class="trace" d={d} />)}
      </g>

      <!-- المخطط (المرحلة ٢) -->
      <g class="schem">
        {wires.map((d) => <path class="wire draw" d={d} />)}
        {parts.map((p) => {
          const [x, y] = p.ex;
          const w = p.id === 'mcu' ? 200 : 150, h = p.id === 'mcu' ? 130 : 90;
          return (
            <g class="node">
              <rect class="draw" x={x - w / 2} y={y - h / 2} width={w} height={h} rx="8" />
              <text x={x} y={y + 7} text-anchor="middle">{p.id.toUpperCase()}</text>
            </g>
          );
        })}
      </g>

      <!-- القطع الحقيقية — مرسومة حول (0,0) ومموضعة على مكان التركيب -->
      <g class="parts">
        <g class="part" data-id="sensor" transform="translate(310,215)">
          <rect x="-75" y="-45" width="150" height="90" rx="10" fill="#1e4f8a" />
          <circle cx="-34" cy="0" r="26" fill="#d5dee6" stroke="#9fb3c4" stroke-width="4" />
          <circle cx="34" cy="0" r="26" fill="#d5dee6" stroke="#9fb3c4" stroke-width="4" />
          <circle cx="-34" cy="0" r="10" fill="#5f7084" /><circle cx="34" cy="0" r="10" fill="#5f7084" />
        </g>
        <g class="part" data-id="screen" transform="translate(690,215)">
          <rect x="-75" y="-45" width="150" height="90" rx="10" fill="#0b1230" stroke="#1c5f77" stroke-width="3" />
          <rect x="-58" y="-30" width="116" height="60" rx="4" fill="#0a2448" />
          <path d="M-46 -14 H30 M-46 0 H46 M-46 14 H10" stroke="#3db7a6" stroke-width="5" stroke-linecap="round" />
        </g>
        <g class="part" data-id="relay" transform="translate(690,425)">
          <rect x="-75" y="-45" width="150" height="90" rx="10" fill="#1c5f77" />
          <rect x="-60" y="-32" width="74" height="64" rx="6" fill="#2a6fd6" />
          <rect x="26" y="-30" width="36" height="60" rx="4" fill="#0b1230" />
          <circle cx="44" cy="-14" r="6" fill="#9fb3c4" /><circle cx="44" cy="12" r="6" fill="#9fb3c4" />
        </g>
        <g class="part" data-id="power" transform="translate(310,425)">
          <rect x="-66" y="-40" width="132" height="80" rx="14" fill="#0e3a63" stroke="#4a6380" stroke-width="3" />
          <rect x="66" y="-14" width="10" height="28" rx="3" fill="#4a6380" />
          <rect x="-50" y="-22" width="70" height="44" rx="6" fill="#3db7a6" />
          <path d="M44 -10 V10 M34 0 H54" stroke="#e9f3f8" stroke-width="5" stroke-linecap="round" />
        </g>
        <g class="part" data-id="mcu" transform="translate(500,320)">
          <rect x="-100" y="-65" width="200" height="130" rx="12" fill="#1c5f77" />
          <g fill="#e3c25a">
            {[-80, -60, -40, -20, 0, 20, 40, 60, 80].map((x) => <rect x={x - 3} y="-74" width="6" height="12" rx="1" />)}
            {[-80, -60, -40, -20, 0, 20, 40, 60, 80].map((x) => <rect x={x - 3} y="62" width="6" height="12" rx="1" />)}
          </g>
          <rect x="-42" y="-42" width="84" height="84" rx="6" fill="#0b1230" />
          <path d="M58 -46 h12 v8 h-12 v8 h12 v8 h-12" fill="none" stroke="#e3c25a" stroke-width="3" />
          <circle class="led" cx="70" cy="40" r="7" fill="#3db7a6" />
        </g>
        {parts.map((p) => (
          <text class="plabel" data-for={p.id} x={p.ex[0]} y={p.ex[1] + (p.id === 'mcu' ? 100 : 78)} text-anchor="middle">{p.name}</text>
        ))}
      </g>

      <!-- الفكرة (المرحلة ١) -->
      <g class="idea">
        <path class="draw" d="M455 360 C 410 330 400 290 400 250 A100 100 0 1 1 600 250 C 600 290 590 330 545 360 Z" />
        <path class="draw" d="M462 388 H538 M470 412 H530 M482 436 H518" />
        <path class="draw fil" d="M468 300 L484 262 L500 300 L516 262 L532 300" />
        <path class="rays" d="M500 112 V86 M390 150 L372 132 M610 150 L628 132 M350 250 H324 M650 250 H676" />
      </g>
    </svg>

    <div class="bp-done">✓ مشروع متكامل وجاهز للمناقشة</div>

    <ol class="bp-steps">
      {labels.map((l, i) => <li class:list={{ on: i === 3 }}><b>{String(i + 1).padStart(2, '0')}</b>{l}</li>)}
    </ol>
  </div>
</section>

<script>
  import { setHeader } from '../scripts/theme';
  const { gsap, ScrollTrigger } = window as any;

  const root = document.getElementById('how')!;
  const $ = (s: string) => [...root.querySelectorAll<SVGGraphicsElement>(s)];
  const caps = $('.bp-cap'), steps = $('.bp-steps li');
  const show = (i: number) => {
    caps.forEach((c, k) => c.classList.toggle('on', k === i));
    steps.forEach((c, k) => c.classList.toggle('on', k <= i));
  };

  if (gsap && ScrollTrigger && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    // رسم الخطوط: dasharray بطول كل شكل
    $('.draw, .trace').forEach((el) => {
      const L = (el as unknown as SVGGeometryElement).getTotalLength();
      gsap.set(el, { strokeDasharray: L, strokeDashoffset: L });
    });
    const at = (id: string) => root.querySelector(`.part[data-id="${id}"]`)!;
    type P = [string, [number, number], [number, number]];
    const parts: P[] = JSON.parse(root.dataset.parts!);
    parts.forEach(([id, [x, y]]) => gsap.set(at(id), { x, y, scale: 0.6, opacity: 0, transformOrigin: '50% 50%' }));
    gsap.set('#how .plate, #how .plabel, #how .bp-done, #how .rays, #how .node text', { opacity: 0 });
    gsap.set('#how .plate', { scale: 0.92, transformOrigin: '50% 50%' });
    show(0);

    const tl = gsap.timeline({ defaults: { ease: 'none' } });
    // ١ الفكرة
    tl.to('#how .idea .draw', { strokeDashoffset: 0, duration: 1.2, stagger: 0.25 })
      .to('#how .rays', { opacity: 1, duration: 0.4 })
      .addLabel('schem', '+=0.6')
      // ٢ المخطط: اللمبة بتنكمش جوّا المتحكم
      .to('#how .idea', { opacity: 0, scale: 0.4, transformOrigin: '50% 50%', duration: 0.8 }, 'schem')
      .to('#how .node .draw', { strokeDashoffset: 0, duration: 1, stagger: 0.12 }, 'schem+=0.3')
      .to('#how .wire', { strokeDashoffset: 0, duration: 1, stagger: 0.15 }, '>-0.4')
      .to('#how .node text', { opacity: 1, duration: 0.4 }, '<')
      .addLabel('parts', '+=0.6')
      // ٣ القطع
      .to('#how .schem', { opacity: 0.18, duration: 0.6 }, 'parts')
      .to('#how .part', { opacity: 1, scale: 1, duration: 0.9, stagger: 0.12, ease: 'back.out(1.6)' }, 'parts')
      .to('#how .plabel', { opacity: 1, duration: 0.5, stagger: 0.08 }, '>-0.4')
      .addLabel('build', '+=0.7')
      // ٤ التركيب
      .to('#how .plabel, #how .schem', { opacity: 0, duration: 0.5 }, 'build')
      .to('#how .plate', { opacity: 1, scale: 1, duration: 0.8 }, 'build');
    parts.forEach(([id, , [x, y]]) => tl.to(at(id), { x, y, duration: 1.2, ease: 'power2.inOut' }, 'build+=0.2'));
    tl.to('#how .trace', { strokeDashoffset: 0, duration: 0.9, stagger: 0.1 }, 'build+=1.2')
      .to('#how .bp-done', { opacity: 1, duration: 0.5 })
      .to({}, { duration: 0.8 });

    const marks = ['schem', 'parts', 'build'].map((l) => tl.labels[l] / tl.duration());
    ScrollTrigger.create({
      trigger: root,
      start: 'top top',
      end: 'bottom bottom',
      scrub: 0.6,
      animation: tl,
      onUpdate: (st: any) => show(marks.filter((m) => st.progress >= m).length),
      onToggle: (st: any) => st.isActive && setHeader('#f3f6f8', '#0a2448'),
      onLeave: () => setHeader('#0e3a63', '#f3f6f8'),
    });
  }
</script>

<style is:global>
  .bp { height: 460vh; position: relative; }
  .bp-stage {
    position: sticky; top: 0; height: 100vh; height: 100dvh; overflow: hidden;
    display: grid; grid-template-rows: auto 1fr auto; justify-items: center;
    padding: 12vh 16px 4vh; gap: 2vh;
    background:
      linear-gradient(rgba(61, 183, 166, .07) 1px, transparent 1px) 0 0 / 48px 48px,
      linear-gradient(90deg, rgba(61, 183, 166, .07) 1px, transparent 1px) 0 0 / 48px 48px,
      radial-gradient(ellipse at 50% 55%, #0e3a63, #0a2448 70%);
    color: #f3f6f8;
  }
  .bp-caps { display: grid; text-align: center; min-height: 6.5em; }
  .bp-cap { grid-area: 1 / 1; opacity: 0; transform: translateY(14px); transition: opacity .45s, transform .6s var(--ease-spring); }
  .bp-cap.on { opacity: 1; transform: none; }
  .bp-cap h2 { font-size: clamp(26px, 4vw, 50px); line-height: 1.2; }
  .bp-cap p { margin-top: 6px; color: #b9cadb; font-size: clamp(14px, 1.5vw, 17px); }

  .bp-svg { width: min(980px, 100%); height: 100%; min-height: 0; overflow: visible; }
  .bp .draw, .bp .rays { fill: none; stroke: #3db7a6; stroke-width: 4; stroke-linecap: round; stroke-linejoin: round; }
  .bp .idea { filter: drop-shadow(0 0 14px rgba(61, 183, 166, .55)); }
  .bp .fil { stroke: #a8efe4; }
  .bp .node rect { stroke-width: 2.5; stroke-dasharray: none; }
  .bp .node text { fill: #3db7a6; font: 600 20px ui-monospace, monospace; letter-spacing: .08em; }
  .bp .wire { stroke-width: 2.5; }
  .bp .trace { fill: none; stroke: #3db7a6; stroke-width: 6; stroke-linecap: round; stroke-linejoin: round; filter: drop-shadow(0 0 6px rgba(61, 183, 166, .8)); }
  .bp .plabel { fill: #e9f3f8; font: 500 22px var(--font); }
  .bp .led { animation: bpled 1.4s ease-in-out infinite; filter: drop-shadow(0 0 8px #3db7a6); }
  @keyframes bpled { 50% { opacity: .3; } }

  .bp-done {
    justify-self: center; align-self: center; grid-row: 2; margin-top: auto;
    position: absolute; bottom: 15vh;
    background: rgba(61, 183, 166, .14); border: 1px solid rgba(61, 183, 166, .5); color: #a8efe4;
    padding: 8px 20px; border-radius: 999px; font-weight: 600; font-size: 15px;
    box-shadow: 0 0 30px rgba(61, 183, 166, .3);
  }
  .bp-steps { list-style: none; display: flex; gap: clamp(10px, 3vw, 40px); font-size: 14px; color: #6f8499; }
  .bp-steps li { display: flex; align-items: center; gap: 8px; transition: color .4s; }
  .bp-steps b { font: 600 12px ui-monospace, monospace; padding: 3px 7px; border-radius: 6px; border: 1px solid currentColor; }
  .bp-steps li.on { color: #3db7a6; }
  @media (max-width: 760px) {
    .bp-stage { padding-top: 10vh; }
    .bp .plabel { font-size: 30px; }
    .bp .node text { font-size: 26px; }
    .bp-done { bottom: 12vh; font-size: 13px; }
    .bp-steps { font-size: 12px; gap: 10px; }
  }
</style>
