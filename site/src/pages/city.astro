---
import Base from '../layouts/Base.astro';
import { svg } from '../data/icons';
---

<Base title="المدينة الذكية — مشاريع" description="مدينة ليلية ثلاثية الأبعاد: كل شخص مبنى، وكل مشروع طابق. حلّق بينها وابنِ مبناك.">
  <main class="city" id="city" data-mode="explore">
    <canvas aria-label="مدينة ذكية ثلاثية الأبعاد تفاعلية"></canvas>

    <div class="hud">
      <div class="brand"><b>مدينتنا الذكية</b><span><em id="c-buildings">0</em> مبنى · <em id="c-projects">0</em> مشروع</span></div>
      <div class="status"><b></b><span>جارٍ تحميل المدينة…</span></div>
      <div class="find"><input id="find" placeholder="ابحث عن مبنى…" autocomplete="off" /><div class="sr"></div></div>
    </div>

    <div class="modebar" role="group" aria-label="وضع التنقل">
      <button id="btn-explore" class="on"><Fragment set:html={svg('compass', 16)} /> استكشف</button>
      <button id="btn-fly"><Fragment set:html={svg('fly', 16)} /> طيران</button>
      <button id="btn-build" class="build"><Fragment set:html={svg('plus', 16)} /> ابنِ مبناك</button>
    </div>
    <p class="keys"><kbd>W A S D</kbd> طيران · <kbd>Space</kbd> ارتفع · <kbd>C</kbd> انزل · <kbd>Shift</kbd> أسرع · اسحب للتدوير</p>

    <div class="tip"></div>
    <div class="toast" role="status"></div>
    <div class="stick" aria-hidden="true"><i></i></div>

    <aside class="panel" aria-live="polite">
      <button class="close" aria-label="إغلاق">×</button>
      <div class="meta"></div>
      <h2></h2>
      <div class="social" hidden>
        <button type="button" class="like" aria-pressed="false"></button>
        <span class="visits"></span>
        <button type="button" class="cbtn"></button>
      </div>
      <div class="cbox" hidden>
        <div class="clist"></div>
        <form class="cform"><input maxlength="200" placeholder="اكتب تعليقك…" autocomplete="off" /><button type="submit">أرسل</button></form>
        <p class="cerr"></p>
      </div>
      <div class="list"></div>
      <div class="pv"><canvas></canvas></div>
      <div class="pm"></div>
      <div class="pt"></div>
      <p class="d"></p>
      <a class="open pill" href="#">افتح صفحة المشروع <i>←</i></a>
    </aside>

    <aside class="builder" aria-label="ابنِ مبناك">
      <button class="close" aria-label="إغلاق">×</button>
      <h2>ابنِ مبناك</h2>
      <p class="sub">كل مشروع تضيفه يصير طابقاً بمبناك. تشوفه ينمو مباشرة على أرضك بالمدينة.</p>
      <label>اسم المبنى<input id="b-name" maxlength="40" placeholder="مثلاً: مختبر نغم" autocomplete="off" /></label>
      <label>نص اللافتة<input id="b-sign" maxlength="28" placeholder="يظهر بالنيون فوق مبناك" autocomplete="off" /></label>
      <div class="lbl">الشكل</div><div class="opts" id="b-styles"></div>
      <div class="lbl">اللون</div><div class="opts colors" id="b-colors"></div>
      <div class="lbl">مشاريعك (<span id="b-count">0</span>/6)</div>
      <input id="b-search" placeholder="ابحث عن مشروع…" autocomplete="off" />
      <div class="plist" id="b-list"></div>
      <div class="auth" id="b-auth" hidden>
        <input id="b-email" type="email" placeholder="بريدك لتسجيل الدخول" dir="ltr" />
        <button type="button" id="b-mail">أرسل رابط الدخول</button>
      </div>
      <p class="err"></p>
      <button class="pill" id="b-save" type="button">ابنِ مبناي</button>
    </aside>

    <div class="nogl">المتصفح لا يدعم العرض ثلاثي الأبعاد.</div>
  </main>
</Base>

<script>
  import { initCity } from '../city/main';
  const el = document.getElementById('city');
  if (el) initCity(el);
</script>

<style is:global>
  html:has(.city), body:has(.city) { background: #061214; overflow: hidden; }
  .city { position: fixed; inset: 0; background: #061214; color: #f3f6f8; user-select: none; -webkit-user-select: none; touch-action: none; }
  .city canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }

  .hud { position: absolute; top: 78px; inset-inline: clamp(12px, 3vw, 40px); z-index: 5; display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; pointer-events: none; }
  .hud > * { pointer-events: auto; }
  .glass { background: rgba(11, 18, 48, .72); backdrop-filter: blur(14px); border: 1px solid rgba(61, 183, 166,.35); box-shadow: 0 0 24px rgba(61, 183, 166,.12); }
  .brand { display: grid; gap: 2px; padding: 10px 18px; border-radius: 18px; background: rgba(11, 18, 48,.72); backdrop-filter: blur(14px); border: 1px solid rgba(61, 183, 166,.35); }
  .brand b { font-size: 17px; letter-spacing: .01em; }
  .brand span { font-size: 12.5px; opacity: .75; } .brand em { font-style: normal; color: var(--orange); font-weight: 700; }
  .status { display: flex; align-items: center; gap: 10px; padding: 10px 18px; border-radius: 999px; font-size: 13.5px; background: rgba(11, 18, 48,.72); backdrop-filter: blur(14px); border: 1px solid rgba(255,255,255,.12); transition: box-shadow .4s, border-color .4s, background .4s; }
  .status b { width: 9px; height: 9px; border-radius: 50%; background: #33d17a; box-shadow: 0 0 10px #33d17a; flex: none; }
  .status.alert { border-color: var(--orange); background: rgba(61, 183, 166,.22); box-shadow: 0 0 30px rgba(61, 183, 166,.5); }
  .status.alert b { background: var(--orange); box-shadow: 0 0 12px var(--orange); animation: pulse .6s infinite; }
  @keyframes pulse { 50% { opacity: .35; } }
  .find { position: relative; }
  .find input { font: 400 14px var(--font); width: min(240px, 42vw); padding: 11px 16px; border-radius: 999px; border: 1px solid rgba(255,255,255,.16); background: rgba(11, 18, 48,.72); backdrop-filter: blur(14px); color: #f3f6f8; outline: none; }
  .find input:focus { border-color: var(--orange); box-shadow: 0 0 0 3px rgba(61, 183, 166,.22); }
  .sr { position: absolute; top: 46px; inset-inline: 0; display: grid; gap: 4px; }
  .sr button { font: 500 13px var(--font); text-align: start; color: #f3f6f8; background: rgba(11, 18, 48,.92); border: 1px solid rgba(61, 183, 166,.3); padding: 9px 14px; border-radius: 12px; cursor: pointer; }
  .sr button:hover { background: rgba(61, 183, 166,.3); }

  .modebar { position: absolute; bottom: 30px; left: 50%; transform: translateX(-50%); z-index: 5; display: flex; gap: 4px; padding: 5px; border-radius: 999px; background: rgba(11, 18, 48,.8); backdrop-filter: blur(16px); border: 1px solid rgba(61, 183, 166,.35); box-shadow: 0 0 40px rgba(61, 183, 166,.15); }
  .modebar button { display: inline-flex; align-items: center; gap: 7px; font: 500 14px var(--font); border: 0; background: transparent; color: #f3f6f8; padding: 10px 18px; border-radius: 999px; cursor: pointer; white-space: nowrap; transition: background .25s; }
  .modebar button.on { background: rgba(255,255,255,.14); }
  .modebar button.build { background: var(--orange); color: #fff; box-shadow: 0 0 22px rgba(61, 183, 166,.6); }
  .panel .social { display: flex; gap: 8px; align-items: center; margin: 12px 0; flex-wrap: wrap; }
  .panel .social button { display: inline-flex; align-items: center; gap: 6px; font: 500 13px var(--font); color: #f3f6f8; background: rgba(255,255,255,.08); border: 1px solid rgba(255,255,255,.16); padding: 7px 14px; border-radius: 999px; cursor: pointer; transition: all .2s; }
  .panel .social button:hover { border-color: var(--orange); }
  .panel .social .like.on { background: rgba(61, 183, 166,.25); border-color: var(--orange); color: #fff; }
  .panel .social .like.on svg { fill: var(--orange); stroke: var(--orange); }
  .panel .social .visits { display: inline-flex; align-items: center; gap: 6px; font-size: 12.5px; opacity: .65; }
  .panel .cbox { margin-bottom: 12px; }
  .panel .clist { display: grid; gap: 8px; max-height: 190px; overflow-y: auto; margin-bottom: 8px; }
  .panel .cm { background: rgba(255,255,255,.06); border-radius: 14px; padding: 9px 13px; font-size: 13px; line-height: 1.7; }
  .panel .cm b { font-size: 12.5px; color: var(--orange); } .panel .cm .x { float: inline-end; border: 0; background: none; color: #f3f6f8; opacity: .5; cursor: pointer; }
  .panel .cform { display: flex; gap: 6px; }
  .panel .cform input { flex: 1; font: 400 13px var(--font); padding: 9px 13px; border-radius: 999px; border: 1px solid rgba(255,255,255,.16); background: rgba(11, 18, 48,.6); color: #f3f6f8; outline: none; }
  .panel .cform input:focus { border-color: var(--orange); }
  .panel .cform button { font: 500 13px var(--font); border: 0; border-radius: 999px; background: var(--orange); color: #fff; padding: 0 16px; cursor: pointer; }
  .panel .cerr { color: #ffb4a0; font-size: 12.5px; margin-top: 6px; }
  .keys { position: absolute; bottom: 8px; inset-inline: 0; text-align: center; font-size: 11.5px; opacity: .55; pointer-events: none; }
  kbd { font: 600 11px var(--font); background: rgba(255,255,255,.12); border: 1px solid rgba(255,255,255,.22); padding: 1px 7px; border-radius: 6px; }

  .tip { position: absolute; top: 0; left: 0; z-index: 6; pointer-events: none; opacity: 0; font-size: 13px; padding: 7px 14px; border-radius: 999px; background: var(--orange); color: #fff; white-space: nowrap; transition: opacity .15s; }
  .tip.on { opacity: 1; }
  .toast { position: absolute; top: 140px; left: 50%; transform: translate(-50%, -10px); z-index: 8; opacity: 0; background: var(--orange); color: #fff; padding: 12px 22px; border-radius: 999px; font-size: 14px; transition: opacity .3s, transform .3s; pointer-events: none; max-width: calc(100% - 24px); text-align: center; box-shadow: 0 0 30px rgba(61, 183, 166,.5); }
  .toast.on { opacity: 1; transform: translate(-50%, 0); }
  .stick { display: none; position: absolute; left: 24px; bottom: 90px; width: 110px; height: 110px; border-radius: 50%; background: rgba(255,255,255,.08); border: 2px solid rgba(255,255,255,.2); z-index: 6; touch-action: none; }
  .stick i { position: absolute; left: 50%; top: 50%; width: 46px; height: 46px; margin: -23px; border-radius: 50%; background: var(--orange); box-shadow: 0 0 20px rgba(61, 183, 166,.7); }
  @media (pointer: coarse) { .stick { display: block; } .keys { display: none; } }

  .panel, .builder { position: absolute; z-index: 6; top: 132px; bottom: 96px; inset-inline-start: clamp(12px, 3vw, 40px); width: min(390px, calc(100% - 24px)); overflow-y: auto; transform: translateX(30px); opacity: 0; pointer-events: none; transition: opacity .4s, transform .5s cubic-bezier(.2,.8,.2,1); background: rgba(11, 18, 48,.9); backdrop-filter: blur(18px); color: #f3f6f8; border-radius: 26px; padding: 26px; border: 1px solid rgba(61, 183, 166,.45); box-shadow: 0 0 50px rgba(61, 183, 166,.2), 0 30px 70px -20px rgba(0,0,0,.7); }
  .panel.open, .builder.open { opacity: 1; transform: none; pointer-events: auto; }
  .panel .meta { font-size: 12.5px; color: var(--orange); margin-bottom: 8px; letter-spacing: .04em; }
  .panel h2, .builder h2 { font-size: 24px; line-height: 1.25; margin-bottom: 14px; padding-inline-end: 34px; }
  .panel .list { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 14px; }
  .panel .list button { font: 500 12.5px var(--font); color: #f3f6f8; background: rgba(255,255,255,.08); border: 1px solid rgba(255,255,255,.14); padding: 7px 12px; border-radius: 999px; cursor: pointer; text-align: start; }
  .panel .list button.on { background: var(--orange); border-color: var(--orange); color: #fff; }
  .pv { display: none; height: 220px; border-radius: 18px; overflow: hidden; margin-bottom: 12px; background: radial-gradient(120% 100% at 50% 100%, #163438 0%, #0b1f22 70%); border: 1px solid rgba(255,255,255,.08); }
  .pv.on { display: block; }
  .pv canvas { width: 100%; height: 100%; display: block; }
  .panel .pm { font-size: 12.5px; opacity: .65; }
  .panel .pt { font-size: 18px; font-weight: 700; margin: 4px 0 8px; }
  .panel .d { font-size: 14.5px; line-height: 1.85; opacity: .82; margin-bottom: 18px; }
  .panel .close, .builder .close { position: absolute; top: 14px; inset-inline-end: 16px; width: 32px; height: 32px; border-radius: 50%; border: 0; background: rgba(255,255,255,.12); color: #f3f6f8; font-size: 19px; cursor: pointer; }
  .panel .pill, .builder .pill { color: var(--green); }

  .builder .sub { font-size: 13.5px; opacity: .78; line-height: 1.8; margin-bottom: 14px; }
  .builder label { display: grid; gap: 6px; font-size: 13px; margin-bottom: 12px; }
  .builder input:not([type='checkbox']) { font: 400 15px var(--font); padding: 11px 14px; border-radius: 14px; border: 1px solid rgba(255,255,255,.16); background: rgba(255,255,255,.07); color: #f3f6f8; width: 100%; outline: none; }
  .builder input:focus { border-color: var(--orange); box-shadow: 0 0 0 3px rgba(61, 183, 166,.25); }
  .builder .lbl { font-size: 13px; margin: 6px 0; }
  .opts { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 12px; }
  .opt svg { flex: none; }
  .opt { font: 500 13px var(--font); border: 1px solid rgba(255,255,255,.18); background: transparent; color: #f3f6f8; padding: 8px 12px; border-radius: 14px; cursor: pointer; display: inline-flex; gap: 6px; align-items: center; }
  .opt.on { background: var(--orange); border-color: var(--orange); color: #fff; }
  .opts.colors .opt { padding: 6px; }
  .opts.colors .opt i { display: block; width: 24px; height: 24px; border-radius: 50%; box-shadow: 0 0 0 2px rgba(255,255,255,.3); }
  .opts.colors .opt.on { background: transparent; box-shadow: 0 0 0 2px #f3f6f8; }
  .plist { max-height: 190px; overflow-y: auto; display: grid; gap: 3px; margin: 8px 0 14px; padding: 4px; background: rgba(0,0,0,.25); border-radius: 14px; }
  .pi { display: flex; align-items: center; gap: 10px; padding: 7px 10px; border-radius: 10px; margin: 0; font-size: 13px; cursor: pointer; }
  .pi:hover { background: rgba(255,255,255,.07); }
  .pi input { accent-color: var(--orange); width: 16px; height: 16px; }
  .auth { display: grid; gap: 8px; margin-bottom: 12px; padding: 12px; background: rgba(61, 183, 166,.16); border-radius: 14px; }
  .auth button { font: 500 14px var(--font); border: 0; background: var(--orange); color: #fff; padding: 10px; border-radius: 12px; cursor: pointer; }
  .err { min-height: 20px; font-size: 13px; color: #ffb59a; margin-bottom: 8px; }
  .nogl { display: none; position: absolute; inset: 0; place-items: center; text-align: center; background: #061214; z-index: 9; }
  .city.no-webgl .nogl { display: grid; }

  @media (max-width: 760px) {
    .hud { top: 66px; flex-wrap: wrap; } .brand { padding: 8px 14px; } .status { font-size: 12px; padding: 8px 12px; }
    .panel, .builder { top: 200px; bottom: 88px; height: auto; inset-inline: 12px; width: auto; padding: 20px; }
    .panel .close, .builder .close { width: 40px; height: 40px; top: 12px; inset-inline-end: 12px; }
    .panel h2, .builder h2 { padding-inline-end: 46px; }
    /* عصا التحكم تختفي وقت فتح اللوحة، كانت بتتغطى */
    .city:has(.panel.open, .builder.open) .stick { display: none; }
    .modebar { bottom: 16px; } .modebar button { padding: 9px 12px; font-size: 13px; }
  }
</style>
