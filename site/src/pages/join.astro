---
import Base from '../layouts/Base.astro';
import '../styles/auth.css';
import AuthArt from '../components/AuthArt.astro';
import { UNIVERSITIES } from '../data/universities';
---

<Base title="حساب جديد — مشاريع" description="أنشئ حسابك بخطوة وحدة: اسمك وبريدك وكلمة سر." isPublic>
  <main class="auth">
    <div class="box" id="j"><p class="c-note">جارٍ التحميل…</p></div>
    <AuthArt />
  </main>
</Base>

<script define:vars={{ UNIVERSITIES }}>window.__UNIS = UNIVERSITIES;</script>

<script>
  import { getBackend } from '../community/backend';
  import { POINTS } from '../community/rules';
  import { uniFromEmail, uniNameOf } from '../data/unimail';
  import { svg } from '../data/icons';
  import { safeNext } from '../scripts/guard.js';

  const UNIS = (window as any).__UNIS as { slug: string; name: string }[];
  const root = document.getElementById('j')!;
  const params = new URLSearchParams(location.search);
  const next = safeNext(params.get('next'));
  const ref = (params.get('ref') || '').slice(0, 64);
  const esc = (s: string) => s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
  const ar = (n: number) => n.toLocaleString('ar-EG');
  const isEmail = (v: string) => /^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(v);

  let be: any;
  (async () => {
    be = await getBackend();
    if (await be.session()) {
      const p = await be.profile().catch(() => null);
      if (p?.display_name && p.display_name !== 'أنت (تجريبي)') { location.replace(next); return; }
    }
    form();
  })();

  function form() {
    root.innerHTML = `
      <div class="brand"><b>مشاريع</b><span>حساب مجاني بخطوة وحدة</span></div>
      <nav class="tabs">
        <a href="/login${location.search}" class="${MODE === 'login' ? 'on' : ''}">تسجيل الدخول</a>
        <a href="/join${location.search}" class="${MODE === 'join' ? 'on' : ''}">حساب جديد</a>
      </nav>
      <div class="card">
        ${ref ? `<div class="refbox">${svg('medal', 18)}<span>صديقك دعاك! بتاخد <b>${ar(POINTS.welcome)} نقاط ترحيب</b> أول ما ننشرلك أول تعليق.</span></div>` : ''}
        <h1>أنشئ حسابك</h1>
        <p class="sub">مجاناً. وبتقدر تتصفّح كل المشاريع بلا حساب أصلاً.</p>

        <label>اسمك<input id="nm" maxlength="40" autocomplete="name" placeholder="مثلاً: نغم أحمد" /></label>

        <label>بريدك الشخصي <small>بيه بتسجّل دخولك، وعليه بيوصلك كود الاستعادة</small>
          <input id="h" type="email" dir="ltr" autocomplete="email" placeholder="you@gmail.com" />
        </label>

        <label>كلمة السر <small>٦ أحرف على الأقل</small>
          <span class="pw"><input id="pw" type="password" autocomplete="new-password" placeholder="••••••••" /><button type="button" id="eye" aria-label="إظهار كلمة السر">${svg('eye', 18)}</button></span>
        </label>

        <details class="more">
          <summary><b>طالب جامعي؟</b><span>اكتب بريدك الجامعي عشان تنضم لمجتمع جامعتك</span></summary>
          <div class="in">
            <label>بريدك الجامعي <small>اختياري</small>
              <input id="ue" type="email" dir="ltr" placeholder="اسمك@yu.edu.jo" />
            </label>
            <div class="found" id="fd" hidden></div>
            <label id="uw" hidden>جامعتك
              <select id="uni"><option value="">— اختر —</option>${UNIS.map((u) => `<option value="${esc(u.name)}">${esc(u.name)}</option>`).join('')}</select>
            </label>
            <div class="two">
              <label>التخصص<input id="mj" maxlength="60" placeholder="هندسة حاسوب" /></label>
              <label>السنة<select id="yr"><option value="">—</option>${[1, 2, 3, 4, 5].map((y) => `<option value="${y}">السنة ${y}</option>`).join('')}</select></label>
            </div>
          </div>
        </details>

        <p class="err" id="e"></p>
        <button type="button" class="c-btn go" id="go">إنشاء حسابي</button>
        <p class="fine">بإنشاء حسابك بتوافق على <a href="/terms">الشروط والأحكام</a>. بريدك ما بيظهر لأحد.</p>
      </div>`;

    const $ = (id: string) => root.querySelector(id) as HTMLInputElement;
    const err = root.querySelector('#e')!, fd = root.querySelector<HTMLElement>('#fd')!;
    const uw = root.querySelector('#uw')!;
    root.querySelector('#eye')!.addEventListener('click', () => { const p = $('#pw'); p.type = p.type === 'password' ? 'text' : 'password'; });

    // الجامعة تُستنتج من نطاق البريد — فلا نسألها مرتين
    $('#ue').addEventListener('input', () => {
      const v = $('#ue').value.trim(), slug = v ? uniFromEmail(v) : null;
      if (slug) {
        fd.hidden = false; fd.className = 'found ok';
        fd.innerHTML = `${svg('medal', 15)} عرفناها: <b>${esc(uniNameOf(slug))}</b>`;
        uw.setAttribute('hidden', '');
      } else if (isEmail(v)) {
        fd.hidden = false; fd.className = 'found';
        fd.textContent = 'ما عرفنا الجامعة من هالنطاق — اخترها تحت.';
        uw.removeAttribute('hidden');
      } else { fd.hidden = true; uw.setAttribute('hidden', ''); }
    });

    root.querySelector('#go')!.addEventListener('click', async () => {
      err.textContent = '';
      const name = $('#nm').value.trim(), handle = $('#h').value.trim(), pw = $('#pw').value, ue = $('#ue').value.trim();
      if (name.length < 2) { err.textContent = 'اكتب اسمك'; return; }
      if (!isEmail(handle)) { err.textContent = 'اكتب بريداً صحيحاً'; return; }
      if (pw.length < 6) { err.textContent = 'كلمة السر ٦ أحرف على الأقل'; return; }
      if (ue && !isEmail(ue)) { err.textContent = 'البريد الجامعي مش مكتوب صح'; return; }

      const slug = ue ? uniFromEmail(ue) : null;
      const profile: any = {
        display_name: name, bio: '', referred_by: ref || null,
        uni_email: ue || null,
        university: slug ? uniNameOf(slug) : ($('#uni')?.value || null),
        major: $('#mj').value.trim() || null,
        year: $('#yr').value ? Number($('#yr').value) : null,
      };

      const btn = root.querySelector('#go') as HTMLButtonElement;
      btn.disabled = true; btn.textContent = 'جارٍ الإنشاء…';
      try {
        const { needsConfirm } = await be.signUp(handle, pw, profile);
        if (needsConfirm) { sent(handle); return; }
        location.href = next;
      } catch (x: any) { err.textContent = x.message; btn.disabled = false; btn.textContent = 'إنشاء حسابي'; }
    });
  }

  function sent(email: string) {
    root.innerHTML = `<div class="brand"><b>مشاريع</b></div><div class="card"><div class="done">
      <span class="big">${svg('send', 26)}</span>
      <h1>أكّد بريدك</h1>
      <p>بعتنا رابط تأكيد على <b dir="ltr">${esc(email)}</b>.<br />افتحه واضغط الرابط، وبيرجّعك هون وحسابك جاهز.</p>
      <p class="fine">ما وصلتك؟ شوف مجلد السبام، أو <a href="/join">جرّب ببريد ثاني</a>.</p>
    </div></div>`;
  }
</script>
