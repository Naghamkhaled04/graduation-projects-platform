---
import { BOARDS } from '../data/boards';
import { svg } from '../data/icons';
---

<section class="bd" id="boards">
  <div class="container">
    <button type="button" class="bd-toggle" id="bd-toggle" aria-expanded="false" aria-controls="bd-body">
      <span class="tx">
        <b>شو الفرق بين الألواح؟</b>
        <small>Arduino · ESP32 · Raspberry Pi · Pico — شو بيقدر يعمل كل واحد، ووين بيفشل</small>
      </span>
      <span class="chev" aria-hidden="true">＋</span>
    </button>

    <div class="bd-wrap" id="bd-body" hidden>
    <div class="bd-main">
      <div class="bd-stage">
        <canvas aria-label="نموذج ثلاثي الأبعاد للوحة التحكم"></canvas>
        <span class="bd-hint">اسحب لتدوير اللوحة</span>
      </div>

      <div class="bd-info" id="bd-info">
        {BOARDS.map((b, i) => (
          <article class="bd-card" data-id={b.id} hidden={i !== 1}>
            <div class="bd-top">
              <div>
                <h3>{b.name}</h3>
                <span class="sub">{b.sub}</span>
              </div>
              <span class="badge">{b.tag}</span>
            </div>

            <dl class="specs">
              <div><dt>المعالج</dt><dd>{b.cpu}</dd></div>
              <div><dt>الذاكرة</dt><dd>{b.ram}</dd></div>
              <div><dt>الدبابيس</dt><dd>{b.io}</dd></div>
              <div><dt>الاتصال</dt><dd>{b.net}</dd></div>
              <div><dt>التغذية</dt><dd>{b.power}</dd></div>
              <div><dt>السعر التقريبي</dt><dd class="pr">{b.price} د.أ</dd></div>
            </dl>

            <div class="pros">
              <ul class="good">{b.good.map((g) => <li>{g}</li>)}</ul>
              <ul class="bad">{b.bad.map((g) => <li>{g}</li>)}</ul>
            </div>

            <p class="use"><b>متى تختاره؟</b> {b.use}</p>
          </article>
        ))}
      </div>
    </div>

    <div class="bd-pick" role="tablist" aria-label="ألواح التحكم">
      {BOARDS.map((b, i) => (
        <button type="button" class:list={['chip', { on: i === 1 }]} data-id={b.id} role="tab" aria-selected={i === 1}>
          <b>{b.name}</b>
          <span>{b.kind === 'حاسوب' ? 'حاسوب كامل' : 'متحكم دقيق'}</span>
        </button>
      ))}
    </div>

    <p class="bd-note">
      <Fragment set:html={svg('box', 15)} />
      القاعدة السريعة: بدك تقرأ حساسات وتتحكم بقطع ← <b>متحكم</b>. بدك تشغّل كاميرا أو ذكاء اصطناعي أو نظام تشغيل ← <b>حاسوب</b>.
    </p>
    </div>
  </div>
</section>

<script>
  import { mountBoards } from '../scripts/boards3d';
  import type { BoardId } from '../model/boards';

  const root = document.getElementById('boards');
  if (root) {
    // مطوي افتراضياً: المجسّم ما بيتحمّل إلا لما يفتحه الطالب
    const toggle = document.getElementById('bd-toggle')!, body = document.getElementById('bd-body')!;
    let started = false;
    toggle.addEventListener('click', () => {
      const open = body.hidden;
      body.hidden = !open;
      toggle.setAttribute('aria-expanded', String(open));
      toggle.querySelector('.chev')!.textContent = open ? '−' : '＋';
      if (open && !started) { started = true; start(); }
      if (open) body.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    });
  }

  function start() {
    const root = document.getElementById('boards')!;
    {
    const canvas = root.querySelector<HTMLCanvasElement>('.bd-stage canvas')!;
    const cards = [...root.querySelectorAll<HTMLElement>('.bd-card')];
    const chips = [...root.querySelectorAll<HTMLButtonElement>('.chip')];
    const viewer = mountBoards(canvas, 'esp32');

    const pick = (id: string) => {
      chips.forEach((c) => { const on = c.dataset.id === id; c.classList.toggle('on', on); c.setAttribute('aria-selected', String(on)); });
      cards.forEach((c) => { const on = c.dataset.id === id; c.hidden = !on; if (on) { c.classList.remove('in'); void c.offsetWidth; c.classList.add('in'); } });
      viewer.show(id as BoardId);
    };
    chips.forEach((c) => c.addEventListener('click', () => pick(c.dataset.id!)));

    // أسهم الكيبورد بين الألواح
    root.querySelector('.bd-pick')!.addEventListener('keydown', (e) => {
      const k = (e as KeyboardEvent).key;
      if (k !== 'ArrowRight' && k !== 'ArrowLeft') return;
      const i = chips.findIndex((c) => c.classList.contains('on'));
      const next = chips[(i + (k === 'ArrowLeft' ? 1 : chips.length - 1)) % chips.length];
      next.focus(); pick(next.dataset.id!);
    });
    }
  }
</script>

<style>
  .bd { background: var(--cream); padding: 40px 0; position: relative; z-index: 1; }
  .bd-toggle { display: flex; align-items: center; justify-content: space-between; gap: 16px; width: 100%;
    text-align: start; background: #fffdf9; border: 1px solid #e6dccd; border-radius: 18px;
    padding: 20px 24px; cursor: pointer; transition: border-color .25s, box-shadow .25s; font: inherit; color: inherit; }
  .bd-toggle:hover { border-color: #fa7b19; box-shadow: 0 2px 8px rgb(26 22 19 / 7%), 0 22px 54px rgb(26 22 19 / 10%); }
  .bd-toggle .tx { display: grid; gap: 4px; }
  .bd-toggle b { font-size: clamp(17px, 2.2vw, 22px); }
  .bd-toggle small { font-size: 13px; color: #7a7168; line-height: 1.7; }
  .bd-toggle .chev { flex: none; width: 38px; height: 38px; border-radius: 50%; background: #fff1e3; color: #d9640b;
    display: grid; place-items: center; font-size: 20px; }
  .bd-wrap { margin-top: 18px; animation: bdOpen .35s cubic-bezier(.22,1,.36,1); }
  .bd-wrap[hidden] { display: none; }
  @keyframes bdOpen { from { opacity: 0; transform: translateY(-8px); } }
  .bd-head { max-width: 62ch; margin-bottom: 34px; }
  .k { display: inline-block; font-size: 13px; background: var(--green); color: var(--cream); padding: 4px 14px; border-radius: 999px; margin-bottom: 12px; }
  .bd-head h2 { font-size: clamp(28px, 5vw, 44px); line-height: 1.18; margin-bottom: 10px; }
  .bd-head p { color: var(--fg-2); font-size: 17px; line-height: 1.9; }

  .bd-main { display: grid; grid-template-columns: 1.05fr 1fr; gap: 24px; align-items: stretch; }

  .bd-stage { position: relative; min-height: 420px; border-radius: 30px; overflow: hidden;
    background: radial-gradient(120% 95% at 50% 105%, #e6dac6 0%, var(--cream-2) 60%, var(--cream) 100%);
    box-shadow: inset 0 0 0 1px rgba(15,61,62,.07); }
  .bd-stage canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; cursor: grab; }
  .bd-stage canvas:active { cursor: grabbing; }
  .bd-hint { position: absolute; bottom: 14px; inset-inline-start: 18px; font-size: 12px; color: var(--fg-2); pointer-events: none; }

  .bd-info { position: relative; }
  .bd-card { background: #fff; border-radius: 30px; padding: clamp(20px, 3vw, 28px); height: 100%;
    box-shadow: 0 0 0 1px rgba(15,61,62,.07), 0 26px 60px -40px rgba(15,61,62,.5); }
  .bd-card[hidden] { display: none; }
  .bd-card.in { animation: bdIn .42s cubic-bezier(.2,.8,.2,1); }
  @keyframes bdIn { from { opacity: 0; transform: translateY(14px); } }

  .bd-top { display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; margin-bottom: 18px; }
  .bd-top h3 { font-size: clamp(21px, 3vw, 27px); line-height: 1.25; }
  .bd-top .sub { font-size: 13.5px; color: var(--fg-2); }
  .badge { flex: none; font-size: 12px; font-weight: 500; background: var(--mint); color: var(--green); padding: 5px 12px; border-radius: 999px; }

  .specs { display: grid; grid-template-columns: 1fr 1fr; gap: 10px 18px; margin-bottom: 18px; }
  .specs div { display: grid; gap: 2px; padding-bottom: 8px; border-bottom: 1px dashed rgba(15,61,62,.12); }
  .specs dt { font-size: 11.5px; color: var(--fg-2); }
  .specs dd { font-size: 13.5px; line-height: 1.6; }
  .specs .pr { color: var(--orange); font-weight: 700; }

  .pros { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-bottom: 16px; }
  .pros ul { list-style: none; display: grid; gap: 6px; align-content: start; }
  .pros li { font-size: 13px; line-height: 1.65; padding-inline-start: 20px; position: relative; color: var(--fg-2); }
  .pros li::before { position: absolute; inset-inline-start: 0; top: 0; font-weight: 700; }
  .good li::before { content: '+'; color: #2f7d5c; }
  .bad li::before { content: '−'; color: #b4553a; }

  .use { font-size: 14px; line-height: 1.9; color: var(--fg-2); background: var(--cream); border-radius: 16px; padding: 12px 16px; }
  .use b { color: var(--green); }

  .bd-pick { display: flex; gap: 8px; margin-top: 18px; overflow-x: auto; padding-bottom: 4px; scrollbar-width: thin; }
  .chip { flex: none; display: grid; gap: 1px; text-align: start; font: 400 13px var(--font); color: var(--green);
    background: #fff; border: 1px solid rgba(15,61,62,.14); border-radius: 18px; padding: 11px 18px; cursor: pointer; transition: all .22s; }
  .chip b { font-size: 14.5px; } .chip span { font-size: 11.5px; color: var(--fg-2); }
  .chip:hover { border-color: var(--orange); }
  .chip.on { background: var(--green); border-color: var(--green); color: var(--cream); }
  .chip.on span { color: rgba(247,239,227,.7); }

  .bd-note { display: flex; align-items: center; gap: 10px; margin-top: 22px; font-size: 14.5px; line-height: 1.9; color: var(--fg-2); }
  .bd-note b { color: var(--green); }
  .bd-note :global(svg) { flex: none; color: var(--orange); }

  @media (max-width: 900px) {
    .bd { padding: 70px 0; }
    .bd-main { grid-template-columns: 1fr; }
    .bd-stage { min-height: 300px; }
    .specs, .pros { grid-template-columns: 1fr; }
    .specs div { padding-bottom: 6px; }
  }
</style>
