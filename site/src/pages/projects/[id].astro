---
import Base from '../../layouts/Base.astro';
import Cart from '../../components/Cart.astro';
import Feedback from '../../components/Feedback.astro';
import { projects, byId } from '../../data/projects';
import details from '../../data/details.json';
import { WHATSAPP, CONSULT_PRICE } from '../../data/config';
import { svg } from '../../data/icons';

export function getStaticPaths() {
  return projects.map((p) => ({ params: { id: p.id } }));
}

const p = byId(Astro.params.id!)!;
const d = (details as Record<string, any>)[p.id] ?? {};

// أرقام عربية → لاتينية (٧٫٥ → 7.5)
const num = (s: string) => Number(String(s).replace(/[٠-٩]/g, (c) => String('٠١٢٣٤٥٦٧٨٩'.indexOf(c))).replace(/٫/g, '.').match(/\d+(\.\d+)?/)?.[0]) || 0;

// المشاريع اللي ما إلها صفحة قديمة: نبني القطع من قائمة الفهرس (بدون بدائل)
const parts: any[] = d.parts?.length
  ? d.parts
  : p.x
    ? []
    : p.bom.map((r, i) => {
        // سعر الفهرس للسطر كامل، والسلة بتضرب سعر القطعة بالكمية
        const qty = num(r[1]) || 1;
        return { id: `b${i}`, nm: r[0], req: true, qty, opts: [{ k: 'x', nm: r[0], d: 'من كتالوج المتجر', p: num(r[2]) / qty, def: true }] };
      });
const extras: any[] = d.extras ?? [];
const description: string = p.d; // المعتمد: وصف الفهرس (ملف index الذي أرسله المستخدم). own-descriptions.json محفوظ للرجوع إليه
const problem: string = d.problem || p.prob;
const feats: string[] = d.feats?.length ? d.feats : p.feat;
const steps: string[][] = d.steps ?? [];
const chals: string[] = d.chals ?? [];
// مشاريع قريبة بالفكرة أو القطع، مع سطر يشرح الفرق — حتى يختار الطالب الصح ويأخذ أفكاراً من الباقي
const related = ((d.rel ?? []) as { id: string; why: string }[])
  .map((x) => ({ r: byId(x.id)!, why: x.why }))
  .filter((x) => !!x.r);
const stack = (d.stack ?? []) as [string, string[]][];
const AR_D = '٠١٢٣٤٥٦٧٨٩';
const ar = (n: number) => String(n).replace(/\d/g, (c) => AR_D[+c]);
/** تمييز عربي: ٣–١٠ جمع، وغيرها مفرد — «٥ طبقات» و«١٤ طبقة» */
const cnt = (n: number, one: string, many: string) => `${ar(n)} ${n >= 3 && n <= 10 ? many : one}`;
const waLink =`https://wa.me/${WHATSAPP}?text=${encodeURIComponent(`مرحباً، بدي أحجز استشارة لمشروع: ${p.t}`)}`;
const waParts = `https://wa.me/${WHATSAPP}?text=${encodeURIComponent(`مرحباً، بدي أفتح قائمة القطع لمشروع: ${p.t}`)}`;
---

<Base title={`${p.t} — مشاريع`} description={description.slice(0, 200)}>
  <main class="pg">
    <div class="container">
      <a class="back" href="/#projects">← كل المشاريع</a>
      <div class="meta"><span class={`lvl ${p.l}`}>{p.ln}</span><span>{p.c}</span>{p.x && <span class="lk"><Fragment set:html={svg('lock', 14)} /> فكرة حصرية</span>}<span class="built" id="built-badge" hidden></span></div>
      <h1>{p.t}</h1>
      <p class:list={['lead', { long: description.length > 400 }]}>{description}</p>

      <button type="button" class="sharebtn" id="share-btn" data-title={p.t} data-level={p.ln} data-domain={p.c}><Fragment set:html={svg('send', 16)} /> شارك على إنستغرام</button>

      <div class="viewer" data-id={p.id}>
        <canvas aria-label={`مجسم ثلاثي الأبعاد: ${p.t}`}></canvas>
        <span class="vhint">اسحب للتدوير · العجلة للتقريب</span>
        <button type="button" class="xbtn" aria-pressed="false">فكّك المجسم</button>
        {p.leg && (
          <ul class="legend">{p.leg.map((l) => <li><i style={`background:${l[0]}`}></i>{l[1]}</li>)}</ul>
        )}
      </div>

      <section><h2>المشكلة</h2><p>{problem}</p></section>

      {steps.length > 0 && (
        <section class="wide">
          <h2>كيف يشتغل</h2>
          <div class="steps">
            {steps.map((s) => <div class="step"><b>{s[0]}</b><span>{s[1]}</span></div>)}
          </div>
        </section>
      )}

      <section>
        <h2>مميزات المشروع</h2>
        <ul>{feats.map((f) => <li>{f}</li>)}</ul>
      </section>

      {chals.length > 0 && (
        <section>
          <h2>التحديات المتوقعة</h2>
          <p class="note">هاي العقبات اللي رح تواجهها وقت التنفيذ، حكيناها من الآخر عشان تكون على بيّنة قبل ما تبلّش.</p>
          <ul>{chals.map((c) => <li>{c}</li>)}</ul>
          <p class="note">بنعطيك حلاً لكل واحدة منها ضمن الاستشارة.</p>
        </section>
      )}

      {related.length > 0 && (
        <section class="wide">
          <h2>مشاريع شبيهة</h2>
          <p class="note">قريبة من هذا المشروع بالفكرة أو بالقطع. اقرأ الفرق قبل ما تقرّر — وخُد منها أفكار تضيفها على مشروعك.</p>
          <div class="rels">
            {related.map(({ r, why }) => (
              <a class="relc" href={`/projects/${r.id}`}>
                <span class="relh"><b>{r.t}</b><span class={`lvl ${r.l}`}>{r.ln}</span></span>
                <span class="relw">{why}</span>
                <span class="relm">{r.c} · {r.cost} د.أ <i>←</i></span>
              </a>
            ))}
          </div>
        </section>
      )}

      {p.sw ? (
        <section class="wide">
          <div class="head">
            <h2>التقنيات المقترحة</h2>
            <span class="cnt">{cnt(stack.length, 'طبقة', 'طبقات')} · {cnt(stack.reduce((n, [, it]) => n + it.length, 0), 'تقنية', 'تقنيات')}</span>
          </div>
          <p class="note">مشروع برمجي — ما في قطع تُشترى. هاي الطبقات اللي بننصح فيها، وكل وحدة بتقدر تبدّلها بما بتتقنه.</p>
          <ol class="stack">
            {stack.map(([grp, items], i) => (
              <li class="stk">
                <span class="sn">{ar(i + 1)}</span>
                <span class="sg">{grp}</span>
                <span class="sitems">{items.map((it) => <span>{it}</span>)}</span>
              </li>
            ))}
          </ol>
          <a class="pill" href={waLink} target="_blank" rel="noopener">احجز استشارة للمسار التقني <i>←</i></a>
        </section>
      ) : p.x ? (
        <section class="locked wide">
          <h2 class="lk"><Fragment set:html={svg('lock', 22)} /> فكرة حصرية من أفكارنا</h2>
          <p>هذه فكرة من أفكارنا نحن، وقمنا بتطويرها بأنفسنا، ولهذا نحافظ على تفاصيلها. قائمة القطع الدقيقة بالكميات والبدائل وسلة الطلب الجاهزة نفتحها لك عند التواصل معنا.</p>
          <div class="range"><span>{d.groups || 'عدة مجموعات قطع'}</span><b>التكلفة التقريبية: {d.range || `${p.cost} د.أ`}</b></div>
          <ul class="perks"><li>القائمة الدقيقة بالكميات</li><li>البدائل والأسعار</li><li>سلة جاهزة للطلب</li></ul>
          <a class="pill" href={waParts} target="_blank" rel="noopener">تواصل معنا لفتح قائمة القطع <i>←</i></a>
        </section>
      ) : (
        <section class="wide cartwrap">
          {d.availnote && <p class="avail">{d.availnote}</p>}
          <Cart parts={parts} extras={extras} project={p.t} />
        </section>
      )}

      <Feedback project={p.id} title={p.t} />

      <section class="gate wide">
        <h2>محتاج حلول للتحديات والطريق التقني كامل؟</h2>
        <p>بالاستشارة بنعطيك حلاً لكل مشكلة من التحديات المذكورة فوق، مع خطة تنفيذ حقيقية تمشي عليها من أول خطوة لآخر وحدة: التقنيات والمكتبات ومخطط التوصيل والخطة الزمنية ونصائح المناقشة.</p>
        <ul class="perks"><li>جلسة استشارة</li><li>مستند PDF بالحلول والخطة</li><li>{CONSULT_PRICE} د.أ فقط</li></ul>
        <a class="pill" href={waLink} target="_blank" rel="noopener">احجز استشارة على واتساب <i>←</i></a>
      </section>

      {['iv', 'vitals', 'fall', 'ecg', 'coma', 'medfridge'].includes(p.id) && (
        <p class="disc">هذا المشروع تعليمي لغايات أكاديمية — ليس جهازاً طبياً معتمداً ولا يُستخدم للتشخيص أو بديلاً عن المتابعة الطبية.</p>
      )}
    </div>
  </main>
</Base>

<script>
  import { guardProject, freeLeftBanner } from '../../scripts/paywall';
  const pg = document.querySelector<HTMLElement>('.pg');
  if (pg) pg.style.visibility = 'hidden';
  const pid = document.querySelector<HTMLElement>('.viewer')?.dataset.id ?? '';
  const allowed = await guardProject(pid);
  if (!allowed) throw new Error('redirect');
  if (pg) { pg.style.visibility = ''; pg.querySelector('.lead')?.insertAdjacentHTML('afterend', freeLeftBanner()); }

  import { mountViewer } from '../../scripts/viewer';
  import { shareCard } from '../../scripts/share';
  const sb = document.getElementById('share-btn');
  sb?.addEventListener('click', () => shareCard({ title: sb.dataset.title!, level: sb.dataset.level!, domain: sb.dataset.domain!, url: location.href }));
  const el = document.querySelector<HTMLElement>('.viewer');
  if (el) mountViewer(el, el.dataset.id!);
</script>

<style>
  .pg { padding: 120px 0 100px; }
  .back { color: var(--fg-2); text-decoration: none; font-size: 14px; }
  .meta { display: flex; gap: 10px; align-items: center; margin: 22px 0 10px; font-size: 14px; color: var(--fg-2); }
  .lvl { font-size: 12px; padding: 4px 12px; border-radius: 999px; background: var(--mint); color: var(--green); }
  .lvl.m { background: #e5dcae; } .lvl.h { background: #f1c9b3; }
  h1 { font-size: clamp(32px, 5vw, 60px); line-height: 1.15; margin-bottom: 18px; max-width: 18ch; }
  .lead { font-size: 19px; color: var(--fg-2); max-width: 62ch; }
  .lead.long { font-size: 17px; line-height: 2; max-width: 74ch; }
  section { margin-top: 56px; max-width: 70ch; }
  section.wide { max-width: 860px; }
  h2 { font-size: 26px; margin-bottom: 14px; }
  ul { padding-inline-start: 20px; display: grid; gap: 8px; }
  .built { background: rgba(232,116,59,.15); color: #a8481c; padding: 3px 12px; border-radius: 999px; font-size: 12.5px; }
  .sharebtn { display: inline-flex; align-items: center; gap: 8px; margin-top: 16px; font: 500 14px var(--font); color: var(--green); background: transparent; border: 1px solid rgba(15,61,62,.25); padding: 9px 18px; border-radius: 999px; cursor: pointer; transition: border-color .2s, background .2s; }
  .sharebtn:hover { border-color: var(--orange); background: rgba(232,116,59,.08); }
  .lk { display: inline-flex; align-items: center; gap: 8px; }
  .note { margin: 8px 0 12px; font-size: 14px; color: var(--fg-2); }
  .steps { display: grid; gap: 10px; counter-reset: s; }
  .step { display: grid; gap: 4px; background: #fff; border-radius: 18px; padding: 16px 20px; box-shadow: 0 0 0 1px rgba(15,61,62,.06); border-inline-start: 4px solid var(--orange); }
  .step b { font-size: 16px; } .step span { color: var(--fg-2); font-size: 14.5px; line-height: 1.8; }
  /* الطبقات: بطاقة واحدة وصفوف، بدل خمس بطاقات نصّها فاضي */
  .stack { list-style: none; padding: 10px 6px; margin: 0 0 22px; display: grid; gap: 2px;
    background: #fff; border-radius: 24px; box-shadow: 0 0 0 1px rgba(15,61,62,.06), 0 16px 40px -30px rgba(15,61,62,.35); }
  .stk { position: relative; display: grid; grid-template-columns: 34px minmax(88px, auto) 1fr; align-items: center;
    gap: 14px; padding: 13px 16px; border-radius: 16px; transition: background .2s; }
  .stk:hover { background: var(--cream); }
  .sn { display: grid; place-items: center; width: 28px; height: 28px; border-radius: 10px;
    background: var(--mint); color: var(--green); font-size: 13px; font-weight: 500; }
  /* خيط رأسي بيوصل الأرقام فيبيّنوا كطبقات مش كصفوف منفصلة */
  .stk:not(:last-child) .sn::after { content: ''; position: absolute; top: 41px; inset-inline-start: 30px;
    width: 2px; height: calc(100% - 28px); background: linear-gradient(var(--mint), transparent); }
  .sg { font-size: 15px; font-weight: 500; color: var(--green); }
  .sitems { display: flex; flex-wrap: wrap; gap: 7px; }
  .sitems span { font-size: 13.5px; padding: 5px 13px; border-radius: 999px; background: var(--cream-2); color: var(--green); }
  @media (max-width: 620px) {
    .stk { grid-template-columns: 28px 1fr; row-gap: 9px; padding: 12px 13px; }
    .sitems { grid-column: 2; }
    .stk:not(:last-child) .sn::after { inset-inline-start: 26px; }
  }
  .avail { margin: 44px 0 -34px; padding: 11px 18px; border-radius: 14px; width: fit-content;
    background: rgba(47,125,92,.12); color: var(--green); font-size: 14px; }
  .avail::before { content: '✓ '; color: #2F7D5C; font-weight: 600; }
  .rels { display: grid; gap: 12px; grid-template-columns: repeat(auto-fit, minmax(270px, 1fr)); }
  .relc { display: grid; gap: 8px; align-content: start; background: #fff; border-radius: 20px; padding: 18px 20px; text-decoration: none; color: inherit;
    box-shadow: 0 0 0 1px rgba(15,61,62,.06); transition: box-shadow .2s, transform .2s; }
  .relc:hover, .relc:focus-visible { box-shadow: 0 0 0 1px rgba(232,116,59,.45), 0 10px 24px -14px rgba(10,46,48,.4); transform: translateY(-2px); }
  .relh { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
  .relh b { font-size: 16px; line-height: 1.35; }
  .relw { color: var(--fg-2); font-size: 14.5px; line-height: 1.8; }
  .relm { font-size: 13.5px; color: var(--green); }
  .relm i { font-style: normal; color: var(--orange); }
  .locked, .gate { padding: 28px; border-radius: 26px; }
  .locked { background: var(--cream-2); }
  .locked .pill { margin-top: 16px; }
  .gate { background: var(--green); color: var(--cream); margin-top: 64px; box-shadow: 0 0 0 1px rgba(232,116,59,.4), 0 0 50px rgba(232,116,59,.14); }
  .gate p { opacity: .85; margin-bottom: 14px; }
  .gate .pill { margin-top: 8px; color: var(--green); }
  .range { display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; margin: 14px 0; padding: 14px 18px; background: #fff; border-radius: 16px; font-size: 15px; }
  .perks { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .perks li { font-size: 13px; padding: 5px 14px; border-radius: 999px; background: rgba(232,116,59,.16); }
  .perks li::before { content: '✓ '; color: var(--orange); }
  .disc { margin-top: 28px; font-size: 13px; color: var(--fg-2); max-width: 70ch; }
  .viewer { position: relative; margin-top: 40px; height: min(68vh, 620px); border-radius: 32px; overflow: hidden; cursor: grab; touch-action: pan-y;
    background: radial-gradient(120% 90% at 50% 100%, #e4d8c3 0%, var(--cream-2) 55%, var(--cream) 100%);
    box-shadow: 0 0 0 1px rgba(15, 61, 62, 0.06), 0 30px 70px -30px rgba(15, 61, 62, 0.35); }
  .viewer:active { cursor: grabbing; }
  .viewer canvas { position: absolute; inset: 0; width: 100%; height: 100%; }
  .vhint { position: absolute; bottom: 16px; inset-inline-start: 20px; font-size: 13px; color: var(--fg-2); background: rgba(255,255,255,.7); padding: 6px 14px; border-radius: 999px; transition: opacity .4s; }
  .viewer.touched .vhint { opacity: 0; }
  .xbtn { position: absolute; bottom: 14px; inset-inline-end: 16px; font: 500 13px var(--font); border: 0; padding: 9px 18px; border-radius: 999px; cursor: pointer; background: var(--orange); color: #fff; box-shadow: 0 0 20px rgba(232,116,59,.5); }
  .xbtn[aria-pressed='true'] { background: var(--green); box-shadow: none; }
  .legend { position: absolute; top: 16px; inset-inline-end: 16px; list-style: none; padding: 12px 16px; display: grid; gap: 6px; font-size: 13px; background: rgba(255,255,255,.75); backdrop-filter: blur(8px); border-radius: 16px; }
  .legend i { display: inline-block; width: 12px; height: 12px; border-radius: 4px; margin-inline-end: 8px; vertical-align: -1px; box-shadow: 0 0 0 1px rgba(0,0,0,.12); }
</style>
